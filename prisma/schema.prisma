// Story 3.12: Evidence Request Workflow model
// Enables GRC Analysts to request evidence from users for specific control domains
// Story 4.2: Risk Template model for pre-built assessment templates (AC1-AC6)
// Templates provide pre-populated control domains and evidence guidance for common security findings
model RiskTemplate {
  id                      String               @id @default(cuid())
  name                    String
  category                RiskTemplateCategory
  description             String               @db.Text
  prePopulatedDomains     String[]             // Array of control domain names
  evidenceGuidance        String               @db.Text
  severityDefault         Severity
  affectedSystemsGuidance String?              @db.Text
  organizationId          String

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risks        Risk[]       @relation("RiskFromTemplate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, category])
  @@index([organizationId])
}

model EvidenceRequest {
  id                 String                @id @default(cuid())
  recipientUserId    String
  requestedById      String
  controlTaxonomyIds String[]              // Array of control domain IDs
  dueDate            DateTime
  instructions       String                @db.Text
  frameworkCode      String?
  status             EvidenceRequestStatus @default(PENDING)
  evidenceId         String?               // Linked when fulfilled
  organizationId     String
  fulfilledAt        DateTime?
  deletedAt          DateTime?             // Soft delete for user deletion cascade
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  // Relationships
  recipient    User          @relation("EvidenceRequestRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("EvidenceRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  evidence     Evidence?     @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Indexes for performance (AC9: organizationId + recipientUserId + status, AC9: organizationId + requestedById)
  @@index([organizationId, recipientUserId, status])
  @@index([organizationId, requestedById])
  @@index([dueDate, status])
  @@index([organizationId])
}

// Story 5.1: Framework Coverage Cache (AC11-AC12)
// Caches calculated framework coverage for performance (refreshed on evidence changes)
// BU-Scoped Compliance: Now supports per-BU coverage (null = org-level rollup)
model FrameworkCoverage {
  id                      String        @id @default(cuid())
  frameworkId             String
  organizationId          String
  // BU-Scoped Compliance: null = org-level rollup, otherwise BU-specific coverage
  businessUnitId          String?
  coveragePercentage      Decimal       @db.Decimal(5, 2)  // 0.00 - 100.00
  satisfiedControlsCount  Int
  totalControlsCount      Int
  lastCalculatedAt        DateTime

  framework               Framework     @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit            BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@unique([frameworkId, organizationId, businessUnitId])
  @@index([organizationId])
  @@index([organizationId, businessUnitId])
}

// Story 5.1: Coverage History for Trend Tracking (AC23-AC27)
// Stores daily snapshots of coverage for trend calculation
// BU-Scoped Compliance: Now supports per-BU history (null = org-level snapshot)
model CoverageHistory {
  id                      String        @id @default(cuid())
  frameworkId             String
  organizationId          String
  // BU-Scoped Compliance: null = org-level snapshot, otherwise BU-specific snapshot
  businessUnitId          String?
  coveragePercentage      Decimal       @db.Decimal(5, 2)  // 0.00 - 100.00
  satisfiedControlsCount  Int
  totalControlsCount      Int
  snapshotDate            DateTime      @db.Date           // Date of snapshot (no time component)

  framework               Framework     @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit            BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  createdAt               DateTime      @default(now())

  @@unique([frameworkId, organizationId, businessUnitId, snapshotDate])
  @@index([organizationId, snapshotDate])
  @@index([frameworkId, snapshotDate])
  @@index([organizationId, businessUnitId, snapshotDate])
}

// Story 7.1: Identifier Sequence for sequential ID generation (AC11-AC15)
// Enables atomic generation of human-readable identifiers (FND-YYYY-NNNN, RSK-YYYY-NNNN, RR-YYYY-NNNN)
model IdentifierSequence {
  id             String @id @default(cuid())
  organizationId String
  prefix         String // FND, RSK, RR
  year           Int    // 4-digit year
  lastSequence   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, prefix, year])
  @@index([organizationId])
}

// Story 7.1: Finding model for Findings Register (AC1-AC10)
// Core entity for tracking security findings from various sources through triage to acceptance
model Finding {
  id             String        @id @default(cuid())
  organizationId String
  identifier     String        // FND-YYYY-NNNN (AC5)
  title          String
  description    String        @db.Text
  source         FindingSource // AC2: AUDIT, PENTEST, SCANNER, INCIDENT, MANUAL
  severity       Severity      // Reuses existing Severity enum (HIGH, MEDIUM, LOW)
  status         FindingStatus @default(NEW) // AC3: NEW → TRIAGED → ACCEPTED

  // Array fields for related data
  affectedAssets String[] @default([]) // List of affected systems/assets
  evidenceIds    String[] @default([]) // IDs of linked evidence

  // Story 7.0.6: Many-to-many relation with BusinessUnit (AC1-AC6)
  affectedBusinessUnits BusinessUnit[] @relation("FindingAffectedBUs")

  // Story 7.0.8: Finding assignment to users (AC1-AC4)
  assigneeId String?

  // Duplicate tracking (AC9)
  duplicateOfId String?

  // Frozen snapshot when finding is accepted (AC6)
  lockedSnapshot Json?

  // Audit trail fields (AC7)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  triagedBy  String?
  triagedAt  DateTime?
  acceptedBy String?
  acceptedAt DateTime?

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation("FindingCreator", fields: [createdBy], references: [id])
  triager      User?        @relation("FindingTriager", fields: [triagedBy], references: [id])
  accepter     User?        @relation("FindingAccepter", fields: [acceptedBy], references: [id])
  assignee     User?        @relation("FindingAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  duplicateOf  Finding?     @relation("FindingDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   Finding[]    @relation("FindingDuplicates")

  // Story 14.7: SLA Tracking fields
  dueDate    DateTime? // SLA due date for remediation
  slaBreached Boolean   @default(false) // Set true when dueDate passes
  closedAt   DateTime? // When finding was closed/remediated

  // AC8: Relation to RiskAssessment (1:1, optional until accepted)
  // Story 7.5: RiskAssessment relation
  riskAssessment RiskAssessment?
  // Story 12.1: Control linkage (AC9-AC16)
  ControlLinks   FindingControlLink[]
  // Story 14.5: Finding Comments
  comments       FindingComment[]
  // Story 14.6: Finding Evidence Attachment
  evidenceLinks  FindingEvidence[]

  // Story 15.10: Risks spawned from this finding
  spawnedRisks   Risk[] @relation("RiskSpawnedFromFinding")

  // ============================================================================
  // Epic 5: Vendor Risk & Finding Integration (FR45-FR50)
  // Links findings to vendors, assessments, and questionnaire responses
  // ============================================================================
  vendorId                String?  // Vendor this finding is associated with
  vendorAssessmentId      String?  // VendorAssessment where finding was discovered
  questionnaireResponseId String?  @unique // QuestionnaireResponse that triggered this finding (1:1)

  // Relations
  vendor                  Vendor?               @relation("VendorFindings", fields: [vendorId], references: [id], onDelete: SetNull)
  vendorAssessment        VendorAssessment?     @relation("VendorAssessmentFindings", fields: [vendorAssessmentId], references: [id], onDelete: SetNull)
  questionnaireResponse   QuestionnaireResponse? @relation("ResponseFinding", fields: [questionnaireResponseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, identifier]) // AC10: Unique identifier per organization
  @@index([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, source])
  @@index([organizationId, assigneeId]) // Story 7.0.8: AC4 - Index for assignee filtering
  @@index([organizationId, dueDate]) // Story 14.7: SLA queries
  @@index([slaBreached, status]) // Story 14.8: SLA breach detection
  // Epic 5: Vendor integration indexes
  @@index([vendorId])
  @@index([vendorAssessmentId])
  @@index([organizationId, vendorId])
}

// Story 7.5: Risk Assessment model (AC1-AC15)
// Bridges findings intake and risk register management with state machine and approval gates
model RiskAssessment {
  id                String           @id @default(cuid())
  organizationId    String
  identifier        String           // RSK-YYYY-NNNN (AC4)
  title             String
  context           String?          @db.Text
  riskCategory      String?
  affectedSystems   String[]         @default([])

  // Scoring - decimal values for matrix-based scoring (AC5)
  likelihoodValue   Decimal?         @db.Decimal(10, 4)
  impactValue       Decimal?         @db.Decimal(10, 4)
  exposureValue     Decimal?         @db.Decimal(10, 4)  // For 3D matrices (future)
  inherentScore     Decimal?         @db.Decimal(10, 4)
  inherentScoreLabel String?

  // Treatment and ownership (AC7)
  treatment         TreatmentType?
  ownerId           String?
  status            AssessmentStatus @default(DRAFT)

  // Story 16.1: Business Context Fields
  businessOwnerId   String?          // Business stakeholder for business decisions
  businessUnitId    String?          // Business unit this assessment belongs to
  performedById     String?          // User who performed the assessment (assessor)
  overallSeverityScore Int?          // Highest severity score from child risks
  overallSeverityLabel String?       // Severity label for overall assessment

  // Risk Owner: Person accountable for this risk assessment
  riskOwnerId       String?          // Person responsible for this risk

  // Source finding link - 1:1 relationship (AC6, AC9)
  findingId         String           @unique

  // Story 7.8.x relations (AC11-AC14)
  assessmentTypeId  String?          // Story 7.8.1 - links to AssessmentType
  matrixVersionId   String?          // Story 7.8.2 - locked at first save (AC15)

  // Story 7.8.1: Assessment Type relation (AC11)
  assessmentType    AssessmentType?  @relation(fields: [assessmentTypeId], references: [id])

  // Audit trail (AC8)
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvedBy        String?
  approvedAt        DateTime?

  // Relations
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding           Finding          @relation(fields: [findingId], references: [id])
  creator           User             @relation("AssessmentCreator", fields: [createdBy], references: [id])
  owner             User?            @relation("AssessmentOwner", fields: [ownerId], references: [id])
  approver          User?            @relation("AssessmentApprover", fields: [approvedBy], references: [id])
  // Story 16.1: Business context relations
  businessOwner     Person?          @relation("AssessmentBusinessOwner", fields: [businessOwnerId], references: [id], onDelete: SetNull)
  businessUnit      BusinessUnit?    @relation("AssessmentBusinessUnit", fields: [businessUnitId], references: [id], onDelete: SetNull)
  performedBy       User?            @relation("AssessmentPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  // Risk Owner: Person accountable for this assessment
  riskOwner         Person?          @relation("AssessmentRiskOwner", fields: [riskOwnerId], references: [id], onDelete: SetNull)
  scenarios         RiskScenario[]   // AC10: Has many risk scenarios
  // Story 16.10: Child risks for this assessment (AC1-AC4)
  childRisks        Risk[]           @relation("AssessmentChildRisks")
  // Story 7.10: Risk Register Entry relation (AC11-AC12)
  riskRegisterEntry RiskRegisterEntry?  // Optional 1:1 - created when approved

  @@unique([organizationId, identifier])
  @@index([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, findingId])
  @@index([organizationId, createdAt])
  @@index([riskOwnerId])
}

// Story 7.5: Risk Scenario model (AC16-AC19)
// Stores risk scenarios for each assessment with ordering
model RiskScenario {
  id              String         @id @default(cuid())
  organizationId  String         // AC17: Tenant isolation
  assessmentId    String
  description     String         @db.Text
  order           Int            @default(0)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations (AC18: Cascade delete when assessment deleted)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment      RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, assessmentId]) // AC19: Index for scenario queries
}

// Story 7.10: Risk Register Entry (AC1, AC3-AC10)
// The operational record for managing approved risks with treatment plans and SLAs
model RiskRegisterEntry {
  id              String             @id @default(cuid())
  organizationId  String
  identifier      String             // RR-YYYY-NNNN (AC3)
  status          RiskRegisterStatus @default(OPEN) // AC8
  treatmentPlan   String?            @db.Text // AC6
  slaDueDate      DateTime?          // AC7
  ownerId         String             // AC5: Required, inherited from assessment
  assessmentId    String             @unique // AC4: 1:1 with RiskAssessment

  // Audit fields (AC9)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  closedAt        DateTime?
  closedBy        String?

  // Relations
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment      RiskAssessment     @relation(fields: [assessmentId], references: [id])
  owner           User               @relation("RiskRegisterOwner", fields: [ownerId], references: [id])
  closer          User?              @relation("RiskRegisterCloser", fields: [closedBy], references: [id])
  // Story 16.6: Status history relation (AC13-AC14)
  statusHistory   RiskRegisterStatusHistory[]

  // Indexes (AC10)
  @@unique([organizationId, identifier])
  @@index([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, slaDueDate])
}

// Story 16.6: Risk Register Status History (AC13-AC14)
// Tracks status transitions with comments and user info
model RiskRegisterStatusHistory {
  id             String             @id @default(cuid())
  entryId        String
  oldStatus      RiskRegisterStatus
  newStatus      RiskRegisterStatus
  comment        String?            @db.Text  // Required for Accept/Close actions
  changedById    String
  organizationId String

  changedAt      DateTime           @default(now())

  // Relations
  entry          RiskRegisterEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  changedBy      User               @relation("RiskRegisterStatusChanger", fields: [changedById], references: [id])

  @@index([entryId, changedAt])
  @@index([organizationId])
}

// Story 12.1: Risk-Control Link (AC1-AC8)
// Links risks to framework controls with typed relationships
model RiskControlLink {
  id             String              @id @default(cuid())
  organizationId String
  riskId         String
  controlId      String
  linkType       RiskControlLinkType // MITIGATING, GAP, AFFECTED
  notes          String?             @db.VarChar(500) // Optional justification

  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  risk           Risk                @relation(fields: [riskId], references: [id], onDelete: Cascade)
  control        Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdBy      User                @relation("RiskControlLinkCreator", fields: [createdById], references: [id])

  @@unique([riskId, controlId]) // AC6: One link per risk-control pair
  @@index([organizationId, riskId]) // AC8: Fast queries by risk
  @@index([organizationId, controlId]) // AC8: Fast queries by control
  @@index([controlId, linkType]) // For control health aggregation
}

// Story 12.1: Finding-Control Link (AC9-AC16)
// Links findings to framework controls with typed relationships
model FindingControlLink {
  id             String                 @id @default(cuid())
  organizationId String
  findingId      String
  controlId      String
  linkType       FindingControlLinkType // VIOLATION, WEAKNESS, OBSERVATION
  notes          String?                @db.VarChar(500) // Optional context

  createdById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // Relations
  finding        Finding                @relation(fields: [findingId], references: [id], onDelete: Cascade)
  control        Control                @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdBy      User                   @relation("FindingControlLinkCreator", fields: [createdById], references: [id])

  @@unique([findingId, controlId]) // AC14: One link per finding-control pair
  @@index([organizationId, findingId]) // AC16: Fast queries by finding
  @@index([organizationId, controlId]) // AC16: Fast queries by control
  @@index([controlId, linkType]) // For control health aggregation
}

// Story 14.5: Finding Comments & Collaboration
// Allows stakeholders to add comments to findings for collaboration on resolution
model FindingComment {
  id             String   @id @default(cuid())
  organizationId String
  findingId      String
  userId         String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  finding      Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  user         User         @relation("FindingCommentUser", fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, findingId])
  @@index([findingId, createdAt])
}

// Story 14.6: Finding Evidence Attachment
// Links findings to evidence from the evidence repository
model FindingEvidence {
  id             String   @id @default(cuid())
  organizationId String
  findingId      String
  evidenceId     String
  attachedById   String
  attachedAt     DateTime @default(now())
  notes          String?  @db.VarChar(500) // Optional context for why evidence was attached

  // Relations
  finding      Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  evidence     Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  attachedBy   User         @relation("FindingEvidenceAttacher", fields: [attachedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([findingId, evidenceId]) // One attachment per finding-evidence pair
  @@index([organizationId, findingId])
  @@index([evidenceId])
}

// ============================================================================
// Story 15.5: MITRE ATT&CK Threat Modeling - Risk Junction Tables
// ============================================================================

// Story 15.5: Risk Threat Step (Attack Chain Techniques)
// Links risks to MITRE techniques representing attack chain steps
model RiskThreatStep {
  id           String   @id @default(cuid())
  riskId       String
  techniqueId  String
  stepOrder    Int      @default(0)  // Order in the attack chain
  notes        String?  @db.VarChar(500)

  createdAt    DateTime @default(now())

  // Relations
  risk         Risk           @relation(fields: [riskId], references: [id], onDelete: Cascade)
  technique    MitreTechnique @relation("ThreatStepTechniques", fields: [techniqueId], references: [id], onDelete: Cascade)

  @@unique([riskId, techniqueId])  // One technique per risk
  @@index([riskId, stepOrder])
  @@index([techniqueId])
}

// Story 15.5: Risk Threat Objective (Target Objectives)
// Links risks to MITRE techniques representing attacker objectives
model RiskThreatObjective {
  id           String   @id @default(cuid())
  riskId       String
  techniqueId  String
  notes        String?  @db.VarChar(500)

  createdAt    DateTime @default(now())

  // Relations
  risk         Risk           @relation(fields: [riskId], references: [id], onDelete: Cascade)
  technique    MitreTechnique @relation("ThreatObjectiveTechniques", fields: [techniqueId], references: [id], onDelete: Cascade)

  @@unique([riskId, techniqueId])  // One technique per risk per objective type
  @@index([riskId])
  @@index([techniqueId])
}

// ============================================================================
// Story 15.8: Risk Treatment with SLA Tracking
// ============================================================================

// Story 15.8: Risk Treatment Record
// Tracks treatment decisions for risks with SLA enforcement
model RiskTreatment {
  id              String            @id @default(cuid())
  organizationId  String
  riskId          String
  treatmentType   TreatmentDecision // ACCEPT, REMEDIATE, TRANSFER, AVOID
  justification   String            @db.Text  // Required for ACCEPT decisions

  // Treatment Action Details
  detail                  String?               @db.Text  // What needs to be done
  assignedToId            String?               // Person responsible for execution
  treatmentBusinessUnitId String?               // Business unit scope
  targetCompletionDate    DateTime?             // When it should be completed
  actionStatus            TreatmentActionStatus @default(NOT_STARTED)

  // SLA tracking (Story 15.9, Story 16.8)
  slaDays           Int?              // SLA from severity threshold
  dueDate           DateTime?         // Calculated from decision date + SLA days
  slaBreached       Boolean           @default(false)
  atRiskNotifiedAt  DateTime?         // Story 16.8: When at-risk notification was sent

  // Workflow tracking
  decidedById     String
  decidedAt       DateTime          @default(now())
  completedAt     DateTime?         // When treatment was completed
  completedById   String?

  // Expected residual severity after this treatment (optional)
  residualLikelihood    Decimal?  @db.Decimal(10, 4)
  residualImpact        Decimal?  @db.Decimal(10, 4)
  residualExposure      Decimal?  @db.Decimal(10, 4)  // For 3D matrices
  residualScore         Decimal?  @db.Decimal(10, 4)
  residualScoreLabel    String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  risk            Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)
  decidedBy       User         @relation("TreatmentDecider", fields: [decidedById], references: [id])
  completedBy     User?        @relation("TreatmentCompleter", fields: [completedById], references: [id])
  assignedTo      Person?      @relation("TreatmentAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  treatmentBusinessUnit BusinessUnit? @relation("TreatmentBusinessUnit", fields: [treatmentBusinessUnitId], references: [id], onDelete: SetNull)

  @@index([organizationId, riskId])
  @@index([riskId])
  @@index([organizationId, dueDate])
  @@index([slaBreached, dueDate])  // For SLA breach detection job
  @@index([assignedToId])
  @@index([treatmentBusinessUnitId])
  @@index([actionStatus, targetCompletionDate])
}

// Story 4.15: Email Queue with Retry Logic (AC1-AC6)
// Queues email notifications for background processing with automatic retry on failure
model EmailQueue {
  id                String           @id @default(cuid())
  to                String           // Recipient email address
  subject           String           // Email subject line
  htmlContent       String           @db.Text // HTML email body
  textContent       String?          @db.Text // Plain text fallback
  emailType         EmailType        // Type for categorization and max retries
  relatedEntityType String?          // "RISK", "EVIDENCE", etc.
  relatedEntityId   String?          // ID of related entity
  status            EmailQueueStatus @default(PENDING)
  retryCount        Int              @default(0) // Current retry attempt
  maxRetries        Int              @default(3) // Max retries (5 for critical, 3 for normal)
  lastRetryAt       DateTime?        // When to attempt next retry
  sentAt            DateTime?        // When email was successfully sent
  error             String?          @db.Text // Error message if failed
  organizationId    String

  // Relationships
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for queue processing (AC4: status + createdAt for FIFO processing)
  @@index([status, createdAt])
  @@index([organizationId, status])
  @@index([relatedEntityId])
  @@index([status, lastRetryAt]) // For retry scheduling
}

// ============================================================================
// Story 13.1: MITRE ATT&CK Data Models
// ============================================================================

// MITRE ATT&CK Tactic (14 tactics in kill chain order)
model MitreTactic {
  id          String   @id @default(cuid())
  externalId  String   @unique // e.g., "TA0001"
  name        String   // e.g., "Initial Access"
  description String   @db.Text
  url         String   // Official MITRE page URL
  shortName   String   // e.g., "initial-access" (used in kill chain phases)
  killChainOrder Int   @default(0) // Order in kill chain (1-14)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many with techniques via junction table
  techniques  MitreTacticTechnique[]

  @@index([killChainOrder])
  @@index([shortName])
}

// MITRE ATT&CK Technique (~200 parent techniques, ~490 sub-techniques)
model MitreTechnique {
  id              String   @id @default(cuid())
  externalId      String   @unique // e.g., "T1566" or "T1566.001"
  name            String   // e.g., "Phishing" or "Spearphishing Attachment"
  description     String   @db.Text
  url             String   // Official MITRE page URL
  isSubTechnique  Boolean  @default(false)

  // Self-referential relation for sub-techniques
  parentId        String?
  parent          MitreTechnique?  @relation("TechniqueSubTechniques", fields: [parentId], references: [id])
  subTechniques   MitreTechnique[] @relation("TechniqueSubTechniques")

  // Detection and mitigation info (optional, parsed from STIX)
  detection       String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Many-to-many with tactics via junction table
  tactics         MitreTacticTechnique[]

  // Story 15.5: Risk linkages via this technique
  risksAsInitialAccess  Risk[]             @relation("RiskInitialAccess")
  riskThreatSteps       RiskThreatStep[]   @relation("ThreatStepTechniques")
  riskThreatObjectives  RiskThreatObjective[] @relation("ThreatObjectiveTechniques")

  @@index([isSubTechnique])
  @@index([parentId])
  @@index([name])
}

// Junction table for Tactic-Technique many-to-many relationship
model MitreTacticTechnique {
  id          String @id @default(cuid())
  tacticId    String
  techniqueId String

  tactic      MitreTactic    @relation(fields: [tacticId], references: [id], onDelete: Cascade)
  technique   MitreTechnique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@unique([tacticId, techniqueId])
  @@index([tacticId])
  @@index([techniqueId])
}

// MITRE ATT&CK sync metadata - tracks last sync for admin UI
model MitreSyncMetadata {
  id            String   @id @default(cuid())
  lastSyncAt    DateTime
  version       String?  // ATT&CK version if available from STIX
  tacticsCount  Int      @default(0)
  techniquesCount Int    @default(0)
  subTechniquesCount Int @default(0)
  syncStatus    MitreSyncStatus @default(SUCCESS)
  errorMessage  String?  @db.Text

  createdAt     DateTime @default(now())
}

enum MitreSyncStatus {
  SUCCESS
  FAILED
  IN_PROGRESS
}

// ============================================================================
// Organizational Controls - User-defined controls that can be linked to risks
// and optionally mapped to framework controls
// ============================================================================

enum OrgControlType {
  MITIGATING    // Controls that reduce risk impact
  PREVENTATIVE  // Controls that prevent risk occurrence
}

enum OrgControlStatus {
  ACTIVE        // Control is actively implemented
  PLANNED       // Control is planned for implementation
  DEPRECATED    // Control is no longer in use
}

enum RiskOrgControlRole {
  IN_PLACE      // Control is currently in place for this risk
  NEEDED        // Control is needed but not yet implemented
}

model OrganizationalControl {
  id              String           @id @default(cuid())
  organizationId  String
  name            String           // e.g., "MFA on Admin Accounts"
  description     String?          @db.Text
  controlType     OrgControlType   @default(MITIGATING)
  status          OrgControlStatus @default(ACTIVE)

  // Optional mapping to a framework control
  frameworkControlId String?

  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  Organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  FrameworkControl Control?          @relation("OrgControlToFrameworkControl", fields: [frameworkControlId], references: [id], onDelete: SetNull)
  CreatedBy        User?             @relation("OrgControlCreator", fields: [createdById], references: [id], onDelete: SetNull)
  RiskLinks        RiskOrganizationalControl[]

  // Story 3.1: Strategy module - Objectives linked to this control
  linkedObjectives Objective[]       @relation("ObjectiveLinkedControls")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([frameworkControlId])
}

model RiskOrganizationalControl {
  id                       String              @id @default(cuid())
  organizationId           String
  riskId                   String
  organizationalControlId  String
  role                     RiskOrgControlRole  // IN_PLACE or NEEDED
  notes                    String?             @db.VarChar(500)

  createdById              String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  // Relationships
  Organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Risk                  Risk                  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  OrganizationalControl OrganizationalControl @relation(fields: [organizationalControlId], references: [id], onDelete: Cascade)
  CreatedBy             User?                 @relation("RiskOrgControlCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([riskId, organizationalControlId])
  @@index([organizationId])
  @@index([riskId])
  @@index([organizationalControlId])
}

// ============================================================================
// Standards Module - Internal organizational standards with framework mappings
// and exception management for compliance auditing
// ============================================================================

enum StandardStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum StandardControlCriticality {
  HIGH
  MEDIUM
  LOW
}

enum StandardMappingType {
  COVERS   // Standard control fully covers the framework control
  PARTIAL  // Standard control partially covers the framework control
  EXCEEDS  // Standard control exceeds framework requirements
}

// Framework-to-Framework Mapping Type
// Used for base framework mapping feature
enum FrameworkMappingType {
  COVERS   // Source control fully covers the base control
  PARTIAL  // Source control partially covers the base control
  EXCEEDS  // Source control exceeds base control requirements
}

// Base type for organization-level base control mapping
// Determines whether organization uses a framework or standard as their base
enum BaseType {
  FRAMEWORK  // Using a framework as the base for mappings
  STANDARD   // Using a standard as the base for mappings
}

enum ControlExceptionStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

// ============================================================================
// Maturity Assessment Module - Framework Maturity Scoring
// Supports NIST CSF 2.0 and C2M2 maturity frameworks
// ============================================================================

enum MaturityFrameworkType {
  NIST_CSF_2   // NIST Cybersecurity Framework 2.0 - Tiers 1-4
  C2M2         // Cybersecurity Capability Maturity Model - MIL 0-3
  OWASP_SAMM   // OWASP Software Assurance Maturity Model v2.1 - Levels 0-3
}

enum AssessmentDepth {
  FUNCTION      // Top level (6 for NIST CSF)
  CATEGORY      // Mid level (22 for NIST CSF)
  SUBCATEGORY   // Detailed (106 for NIST CSF)
}

enum AssessmentMode {
  SELF          // Quick self-scoring
  GUIDED        // Wizard with questions
  HYBRID        // Mix of both
}

enum MaturityAssessmentStatus {
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum AssessorAssignmentStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

// ============================================================================
// Compliance Assessment Module - Enums
// ============================================================================

// Compliance status for individual control assessments
enum ComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
  PARTIALLY_COMPLIANT
  NOT_ASSESSED
  NOT_APPLICABLE
}

// Status lifecycle for compliance assessments
enum ComplianceAssessmentStatus {
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

// Epic 1: TPRM Vendor Registry - Vendor Status enum
// Lifecycle states for vendor management (FR5)
enum VendorStatus {
  ACTIVE        // Vendor is actively engaged
  INACTIVE      // Vendor temporarily inactive
  UNDER_REVIEW  // Vendor under compliance/security review
  OFFBOARDED    // Vendor relationship terminated (soft delete)
}

// Risk tier classification for vendors (FR11)
enum VendorRiskTier {
  CRITICAL      // 6-month review cycle
  HIGH          // 12-month review cycle
  MEDIUM        // 18-month review cycle
  LOW           // 24-month review cycle
}

// Epic 3: Vendor Assessment Workflow - Status enum (FR20)
// Lifecycle states for vendor assessments
enum VendorAssessmentStatus {
  DRAFT         // Assessment created, not yet started
  IN_PROGRESS   // Assessor actively working on assessment
  IN_REVIEW     // Submitted for review, awaiting approval
  COMPLETED     // Assessment finalized and closed
}

// Epic 3: Vendor Assessment Recommendation (FR22)
// Assessment outcome recommendations
enum VendorAssessmentRecommendation {
  APPROVE              // Vendor approved without conditions
  CONDITIONAL_APPROVE  // Vendor approved with conditions that must be met
  REJECT               // Vendor rejected, engagement not recommended
}

// Epic 4: Questionnaire System - Question Types (FR28)
// Supported question types for questionnaire builder
enum QuestionType {
  TEXT          // Short or long text answer
  YES_NO        // Boolean yes/no selection
  MULTI_CHOICE  // Single selection from options
  FILE_UPLOAD   // File attachment for evidence
}

// Epic 4: Questionnaire System - Questionnaire Status (FR32)
// Tracks questionnaire delivery and response lifecycle
enum QuestionnaireStatus {
  DRAFT         // Questionnaire created but not sent
  SENT          // Sent to vendor, awaiting response
  VIEWED        // Vendor accessed the link
  IN_PROGRESS   // Vendor started responding
  COMPLETED     // Vendor submitted responses
  VOIDED        // Questionnaire cancelled/invalidated
}

// Epic 4: Questionnaire System - Response Score (FR35)
// Assessor scoring for individual responses
enum ResponseScore {
  ACCEPTABLE       // Response is satisfactory
  NEEDS_FOLLOWUP   // Response requires further clarification
  UNACCEPTABLE     // Response indicates a concern/issue
}

// Organizational Standard - Internal policies and standards
model Standard {
  id              String         @id @default(cuid())
  organizationId  String
  title           String
  description     String         @db.Text
  ownerId         String?
  effectiveDate   DateTime
  reviewCycleMonths Int          @default(12)
  status          StandardStatus @default(DRAFT)
  version         Int            @default(1)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdById     String?

  // Relationships
  Organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Owner           User?          @relation("StandardOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  CreatedBy       User?          @relation("StandardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  Controls        StandardControl[]
  // Base-centric Control Mapping: Organizations using this standard as base
  OrganizationsAsBase Organization[] @relation("BaseStandard")

  @@unique([organizationId, title])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([ownerId])
}

// Standard Control - Specific requirements within a standard
model StandardControl {
  id              String                     @id @default(cuid())
  standardId      String
  code            String                     // e.g., "SEC-001", "AC-1.1"
  title           String
  description     String?                    @db.Text
  criticality     StandardControlCriticality @default(MEDIUM)
  sortOrder       Int                        @default(0)

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  // Relationships
  Standard        Standard                   @relation(fields: [standardId], references: [id], onDelete: Cascade)
  FrameworkMappings StandardControlMapping[]
  Exceptions      ControlException[]
  // Control Domain tagging
  ControlDomains  ControlDomainStandardControl[]

  @@unique([standardId, code])
  @@index([standardId])
  @@index([standardId, sortOrder])
}

// Standard Control to Framework Control Mapping
model StandardControlMapping {
  id                  String              @id @default(cuid())
  standardControlId   String
  controlId           String              // Framework control ID
  mappingType         StandardMappingType @default(COVERS)
  notes               String?             @db.Text

  createdAt           DateTime            @default(now())
  createdById         String?

  // Relationships
  StandardControl     StandardControl     @relation(fields: [standardControlId], references: [id], onDelete: Cascade)
  FrameworkControl    Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  CreatedBy           User?               @relation("StandardMappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([standardControlId, controlId])
  @@index([standardControlId])
  @@index([controlId])
}

// Framework Control to Framework Control Mapping (Base Framework Mapping Feature)
// Maps controls from other frameworks to controls in the designated "base framework"
model FrameworkControlMapping {
  id                  String               @id @default(cuid())
  organizationId      String

  sourceControlId     String               // FK to Control (from non-base framework)
  targetControlId     String               // FK to Control (from base framework)

  mappingType         FrameworkMappingType @default(COVERS)
  confidence          Int                  @default(100)  // 0-100
  notes               String?              @db.Text

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdById         String?

  // Relationships
  Organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  SourceControl       Control              @relation("SourceControlMappings", fields: [sourceControlId], references: [id], onDelete: Cascade)
  TargetControl       Control              @relation("TargetControlMappings", fields: [targetControlId], references: [id], onDelete: Cascade)
  CreatedBy           User?                @relation("FrameworkMappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sourceControlId, targetControlId])
  @@index([organizationId])
  @@index([organizationId, sourceControlId])
  @@index([organizationId, targetControlId])
}

// Control Exception - Time-bound exemptions from standard controls
model ControlException {
  id                  String                 @id @default(cuid())
  organizationId      String
  standardControlId   String

  status              ControlExceptionStatus @default(PENDING)
  justification       String                 @db.Text
  compensatingControls String?               @db.Text

  requestedById       String
  requestedAt         DateTime               @default(now())

  approvedById        String?
  approvedAt          DateTime?
  approvalNotes       String?                @db.Text

  expiresAt           DateTime
  renewalCount        Int                    @default(0)

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  // Relationships
  Organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  StandardControl     StandardControl        @relation(fields: [standardControlId], references: [id], onDelete: Cascade)
  RequestedBy         User                   @relation("ExceptionRequestedBy", fields: [requestedById], references: [id])
  ApprovedBy          User?                  @relation("ExceptionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([standardControlId])
  @@index([requestedById])
  @@index([expiresAt])
  @@index([status, expiresAt])  // For expiration check jobs
}

// ============================================================================
// Maturity Assessment Module - Models
// ============================================================================

// MaturityFramework - Template for maturity frameworks (NIST CSF 2.0, C2M2)
model MaturityFramework {
  id               String                @id @default(cuid())
  organizationId   String?               // null = system template
  type             MaturityFrameworkType
  name             String
  version          String
  description      String?               @db.Text

  // Scoring configuration
  minLevel         Int                   // 0 for C2M2, 1 for others
  maxLevel         Int                   // 3 for C2M2, 4 for NIST
  scoringLevels    Json                  // [{value, label, description, criteria}]

  isActive         Boolean               @default(true)
  isSystemTemplate Boolean               @default(false)

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains          MaturityDomain[]
  assessments      MaturityAssessment[]
  questions        MaturityQuestion[]

  @@unique([organizationId, type, version])
  @@index([organizationId, isActive])
  @@index([type])
}

// MaturityDomain - Hierarchical domains within a framework (Function → Category → Subcategory)
model MaturityDomain {
  id              String            @id @default(cuid())
  frameworkId     String
  parentId        String?           // Self-referencing hierarchy
  code            String            // GV, ID, PR, etc.
  name            String
  description     String?           @db.Text
  level           AssessmentDepth   // FUNCTION, CATEGORY, SUBCATEGORY
  sortOrder       Int               @default(0)

  framework       MaturityFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  parent          MaturityDomain?   @relation("DomainHierarchy", fields: [parentId], references: [id])
  children        MaturityDomain[]  @relation("DomainHierarchy")

  scores          MaturityDomainScore[]
  questions       MaturityQuestion[]
  // Control Domain tagging
  ControlDomains  ControlDomainMaturityDomain[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([frameworkId, code])
  @@index([frameworkId, level])
  @@index([parentId])
}

// MaturityAssessment - An organization's assessment against a maturity framework
model MaturityAssessment {
  id              String                    @id @default(cuid())
  organizationId  String
  frameworkId     String
  identifier      String                    // MAT-YYYY-NNNN
  name            String
  description     String?                   @db.Text

  assessmentDepth AssessmentDepth           @default(FUNCTION)
  assessmentMode  AssessmentMode            @default(SELF)
  status          MaturityAssessmentStatus  @default(DRAFT)

  // Current scores (editable)
  overallLevel    Int?
  overallScore    Decimal?                  @db.Decimal(5, 2)

  // Target planning
  targetLevel     Int?
  targetDate      DateTime?

  // Ownership
  ownerId         String

  // Approval workflow
  submittedAt     DateTime?
  submittedBy     String?
  approvedAt      DateTime?
  approvedBy      String?

  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework       MaturityFramework         @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  owner           User                      @relation("MaturityAssessmentOwner", fields: [ownerId], references: [id])
  submitter       User?                     @relation("MaturityAssessmentSubmitter", fields: [submittedBy], references: [id])
  approver        User?                     @relation("MaturityAssessmentApprover", fields: [approvedBy], references: [id])

  domainScores    MaturityDomainScore[]
  assignees       AssessorAssignment[]
  snapshots       MaturitySnapshot[]
  responses       MaturityQuestionResponse[]

  @@unique([organizationId, identifier])
  @@index([organizationId, status])
  @@index([organizationId, frameworkId])
}

// MaturityDomainScore - Score for a specific domain within an assessment
model MaturityDomainScore {
  id              String            @id @default(cuid())
  assessmentId    String
  domainId        String

  currentLevel    Int?
  targetLevel     Int?
  confidence      String?           // LOW, MEDIUM, HIGH
  notes           String?           @db.Text
  evidenceLinks   String[]          @default([])

  assessedBy      String?
  assessedAt      DateTime?

  assessment      MaturityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  domain          MaturityDomain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  assessor        User?              @relation("MaturityDomainScoreAssessor", fields: [assessedBy], references: [id])

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([assessmentId, domainId])
  @@index([assessmentId])
}

// AssessorAssignment - Multi-assessor workflow assignments
model AssessorAssignment {
  id              String                   @id @default(cuid())
  assessmentId    String
  userId          String

  assignedDomains String[]                 // Domain codes
  status          AssessorAssignmentStatus @default(PENDING)

  assignedAt      DateTime                 @default(now())
  submittedAt     DateTime?

  assessment      MaturityAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user            User                     @relation("AssessorAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId, status])
}

// MaturitySnapshot - Historical point-in-time snapshots of assessments
model MaturitySnapshot {
  id              String            @id @default(cuid())
  assessmentId    String
  snapshotDate    DateTime          @db.Date

  overallLevel    Int
  overallScore    Decimal           @db.Decimal(5, 2)
  domainScores    Json              // Frozen copy of all domain scores

  triggeredBy     String            // User who triggered snapshot
  reason          String?           // Why snapshot was taken

  assessment      MaturityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user            User               @relation("MaturitySnapshotTriggeredBy", fields: [triggeredBy], references: [id])

  createdAt       DateTime          @default(now())

  @@unique([assessmentId, snapshotDate])
  @@index([assessmentId, snapshotDate])
}

// MaturityQuestion - Questions for guided assessment (official + custom)
model MaturityQuestion {
  id              String            @id @default(cuid())
  frameworkId     String
  domainId        String?           // null = framework-level question
  organizationId  String?           // null = official, set = custom

  questionText    String            @db.Text
  guidanceText    String?           @db.Text
  answerType      String            // SCALE, YES_NO, TEXT, EVIDENCE, PRACTICE
  weight          Decimal           @db.Decimal(3, 2) @default(1.0)
  isOfficial      Boolean           @default(false)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)

  // C2M2 Practice-specific fields / SAMM question fields
  practiceCode    String?           // e.g., "ASSET-1a", "THREAT-2c", "G-SM-A-1"
  practiceLevel   Int?              // MIL level this practice belongs to (1, 2, or 3)
  answerOptions   Json?             // SAMM: [{value: 0, label: "No", weight: 0}, {value: 1, label: "Yes, for some...", weight: 0.25}, ...]

  framework       MaturityFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  domain          MaturityDomain?   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  organization    Organization?     @relation("MaturityQuestionOrg", fields: [organizationId], references: [id], onDelete: Cascade)

  responses       MaturityQuestionResponse[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([frameworkId, practiceCode]) // Prevent duplicate practice codes per framework
  @@index([frameworkId, domainId])
  @@index([organizationId, isActive])
  @@index([frameworkId, practiceLevel]) // For efficient MIL-level queries
}

// MaturityQuestionResponse - Responses to guided assessment questions
model MaturityQuestionResponse {
  id              String            @id @default(cuid())
  assessmentId    String
  questionId      String

  answer          String?           @db.Text
  scaleValue      Int?
  isPerformed     Boolean?          // For C2M2 practices: true = performed, false = not performed
  evidenceIds     String[]          @default([])
  notes           String?           @db.Text
  interviewee     String?           @db.Text  // Name/role of person interviewed

  answeredBy      String
  answeredAt      DateTime          @default(now())

  assessment      MaturityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question        MaturityQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user            User               @relation("MaturityQuestionResponseAnswerer", fields: [answeredBy], references: [id])

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// ============================================================================
// Compliance Assessment Module - Models
// ============================================================================

// ComplianceAssessment - Formal assessment of compliance against a framework
model ComplianceAssessment {
  id              String                      @id @default(cuid())
  organizationId  String
  frameworkId     String
  businessUnitId  String?                     // Optional: Which BU is being assessed
  identifier      String                      // COMP-YYYY-NNNN
  name            String
  description     String?                     @db.Text
  status          ComplianceAssessmentStatus  @default(DRAFT)
  baseline        String?                     // Selected baseline filter: "LOW", "MODERATE", "HIGH", "PRIVACY", or null (all)

  // Metrics (auto-calculated from control scores)
  totalControls       Int     @default(0)
  compliantCount      Int     @default(0)
  nonCompliantCount   Int     @default(0)
  partialCount        Int     @default(0)
  notApplicableCount  Int     @default(0)
  notAssessedCount    Int     @default(0)
  complianceScore     Decimal? @db.Decimal(5, 2)  // 0-100 percentage

  // Ownership
  ownerId         String
  assessorId      String?

  // Workflow
  submittedAt     DateTime?
  submittedById   String?
  approvedAt      DateTime?
  approvedById    String?

  // Target dates
  targetCompletionDate DateTime?
  dueDate              DateTime?

  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  // Relations
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework       Framework                   @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit?               @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  owner           User                        @relation("ComplianceAssessmentOwner", fields: [ownerId], references: [id])
  assessor        User?                       @relation("ComplianceAssessmentAssessor", fields: [assessorId], references: [id])
  submittedBy     User?                       @relation("ComplianceAssessmentSubmitter", fields: [submittedById], references: [id])
  approvedBy      User?                       @relation("ComplianceAssessmentApprover", fields: [approvedById], references: [id])

  controlScores   ControlAssessmentScore[]

  @@unique([organizationId, identifier])
  @@index([organizationId, status])
  @@index([organizationId, frameworkId])
  @@index([organizationId, businessUnitId])
  @@index([ownerId])
  @@index([assessorId])
}

// ControlAssessmentScore - Individual control compliance scores within an assessment
model ControlAssessmentScore {
  id              String            @id @default(cuid())
  assessmentId    String
  controlId       String

  status          ComplianceStatus  @default(NOT_ASSESSED)
  notes           String?           @db.Text
  evidenceLinks   String[]          @default([])

  // Gap tracking
  gapDescription    String?         @db.Text
  remediationPlan   String?         @db.Text
  remediationDueDate DateTime?

  // Audit
  assessedById    String?
  assessedAt      DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  assessment      ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control         Control              @relation(fields: [controlId], references: [id], onDelete: Cascade)
  assessedBy      User?                @relation("ControlScoreAssessor", fields: [assessedById], references: [id])

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
  @@index([controlId])
  @@index([assessmentId, status])
}

// ============================================================================
// Risk Assessment Project Feature - Container-based risk discovery workflow
// Enables analysts to create assessment "containers" for subjects, discover
// multiple risks, and submit for manager approval before publishing to register
// ============================================================================

model RiskAssessmentProject {
  id                    String                  @id @default(cuid())
  organizationId        String

  // Assessment subject and description
  subject               String                  // What is being assessed (e.g., "AWS Migration Project")
  description           String?                 @db.Text  // Optional description/scope of the assessment

  // Risk matrix for scoring all risks in this project
  matrixVersionId       String?                 // Risk matrix version used for scoring

  // Assignment and ownership
  assigneeId            String?                 // Analyst assigned to perform the assessment (null = backlog)
  createdById           String                  // User who created the assessment
  riskOwnerId           String?                 // Person accountable for risks in this assessment

  // Workflow status
  status                AssessmentProjectStatus @default(IN_PROGRESS)
  dueDate               DateTime                // Deadline for completing the assessment

  // Submission tracking
  submittedAt           DateTime?               // When analyst submitted for review

  // Review tracking
  reviewerId            String?                 // Manager who reviewed the assessment
  reviewedAt            DateTime?               // When review was completed
  rejectionNotes        String?                 @db.Text  // Notes from reviewer if rejected

  // Reassessment chain
  parentAssessmentId    String?                 // Link to parent assessment for reassessments
  reassessmentDueDate   DateTime?               // Calculated on approval based on highest severity

  // Timestamps
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  // Relations
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee              User?                   @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy             User                    @relation("ProjectCreator", fields: [createdById], references: [id])
  reviewer              User?                   @relation("ProjectReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  riskOwner             Person?                 @relation("ProjectRiskOwner", fields: [riskOwnerId], references: [id], onDelete: SetNull)
  parentAssessment      RiskAssessmentProject?  @relation("ReassessmentChain", fields: [parentAssessmentId], references: [id], onDelete: SetNull)
  childAssessments      RiskAssessmentProject[] @relation("ReassessmentChain")
  matrixVersion         RiskMatrixVersion?      @relation("ProjectMatrixVersion", fields: [matrixVersionId], references: [id], onDelete: SetNull)

  // Discovered risks within this assessment project
  discoveredRisks       Risk[]                  @relation("ProjectDiscoveredRisks")

  // Indexes for efficient querying
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assigneeId])
  @@index([assigneeId])
  @@index([status])
  @@index([reassessmentDueDate])
  @@index([organizationId, reassessmentDueDate])
  @@index([parentAssessmentId])
  @@index([createdById])
  @@index([matrixVersionId])
  @@index([riskOwnerId])
}

// ============================================================================
// Epic 1: TPRM Vendor Registry Module - Vendor Model
// Central registry for third-party vendors with ownership, status tracking,
// and role-based access control
// ============================================================================

model Vendor {
  id                  String          @id @default(cuid())
  identifier          String          // VND-YYYY-NNNN format
  organizationId      String
  name                String
  category            String?         // e.g., "Cloud Services", "Security Tools"
  status              VendorStatus    @default(ACTIVE)

  // Risk Tiering (FR11-FR16)
  riskTier            VendorRiskTier? // Critical, High, Medium, Low
  nextReviewDate      DateTime?       // Auto-calculated based on tier, can be overridden
  reviewDateOverridden Boolean        @default(false) // True if manually overridden
  reviewOverrideReason String?        // Reason for manual override (required if overridden)

  // Primary Contact (FR1)
  primaryContactName  String?
  primaryContactEmail String?

  // Ownership (FR6, FR7)
  businessUnitId      String?         // Which BU owns this vendor relationship
  itOwnerId           String?         // IT stakeholder responsible for technical oversight
  businessOwnerId     String?         // Business stakeholder responsible for relationship

  // Audit fields
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  createdById         String?

  // Relations
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit        BusinessUnit?   @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  itOwner             Person?         @relation("VendorITOwner", fields: [itOwnerId], references: [id], onDelete: SetNull)
  businessOwner       Person?         @relation("VendorBusinessOwner", fields: [businessOwnerId], references: [id], onDelete: SetNull)
  createdBy           User?           @relation("VendorCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Relations to assessments (Epic 3)
  assessments         VendorAssessment[]

  // Epic 5: Findings and Risks linked to this vendor (FR47, FR49)
  findings            Finding[]          @relation("VendorFindings")
  risks               Risk[]             @relation("VendorRisks")

  // BIA Module: Business Processes linked to this vendor (FR33, FR40)
  businessProcessLinks BusinessProcessVendor[]

  // Unique identifier per organization
  @@unique([organizationId, identifier])

  // Indexes for efficient querying (FR2, FR8-FR10, FR11-FR16)
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, riskTier])
  @@index([organizationId, nextReviewDate])
  @@index([organizationId, businessUnitId])
  @@index([itOwnerId])
  @@index([businessOwnerId])
}

// ============================================================================
// Epic 3: Vendor Assessment Workflow
// Structured vendor assessments with status tracking, scoring, recommendations
// FR17-FR26
// ============================================================================

model VendorAssessment {
  id                  String                         @id @default(cuid())
  identifier          String                         // VA-YYYY-NNNN format
  organizationId      String
  vendorId            String

  // Assessment Details (FR17, FR19)
  title               String
  dueDate             DateTime?

  // Status Workflow (FR20)
  status              VendorAssessmentStatus         @default(DRAFT)
  statusChangedAt     DateTime?                      // When status last changed

  // Assessor Assignment (FR18)
  assessorId          String?                        // User assigned to conduct assessment

  // Scoring and Recommendation (FR21, FR22)
  riskScore           Int?                           // 0-100 risk score
  recommendation      VendorAssessmentRecommendation?
  conditions          String?                        @db.Text // Conditions for CONDITIONAL_APPROVE
  rejectionReason     String?                        @db.Text // Reason if REJECT

  // Summary and Notes (FR23)
  summary             String?                        @db.Text

  // Completion tracking
  completedAt         DateTime?
  completedById       String?                        // User who marked as completed

  // Audit fields
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  createdById         String?

  // Relations
  organization        Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor              Vendor                         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assessor            User?                          @relation("AssessmentAssessor", fields: [assessorId], references: [id], onDelete: SetNull)
  completedBy         User?                          @relation("AssessmentCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy           User?                          @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Comments (FR26)
  comments            VendorAssessmentComment[]

  // Questionnaires (FR30)
  questionnaires      AssessmentQuestionnaire[]

  // Epic 5: Findings and Risks created from this assessment (FR45-FR50)
  findings            Finding[]          @relation("VendorAssessmentFindings")
  risks               Risk[]             @relation("VendorAssessmentRisks")

  // Unique identifier per organization
  @@unique([organizationId, identifier])

  // Indexes for efficient querying
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, vendorId])
  @@index([vendorId])
  @@index([assessorId])
  @@index([organizationId, dueDate])
}

// Comments on vendor assessments (FR26)
// IT Stakeholders can add comments to assessments for vendors they own
model VendorAssessmentComment {
  id                  String               @id @default(cuid())
  assessmentId        String
  authorId            String
  content             String               @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Relations
  assessment          VendorAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  author              User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([authorId])
}

// ============================================================================
// Epic 4: Questionnaire System (FR27-FR36)
// Enables structured information gathering from vendors via customizable
// questionnaires attached to vendor assessments
// ============================================================================

// Questionnaire Template (FR27, FR28, FR29)
// Reusable questionnaire templates that can be attached to assessments
model QuestionnaireTemplate {
  id              String       @id @default(cuid())
  organizationId  String?      // Null for system templates (pre-built)
  name            String
  description     String?      @db.Text
  isSystemTemplate Boolean     @default(false) // True for pre-built templates
  isActive        Boolean      @default(true)
  version         Int          @default(1)

  // Timestamps
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdById     String?

  // Relations
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?        @relation("QuestionnaireTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Child entities
  sections        QuestionnaireSection[]
  questionnaires  AssessmentQuestionnaire[] // Instances created from this template

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([isSystemTemplate])
}

// Questionnaire Section (FR28)
// Groups questions within a template
model QuestionnaireSection {
  id              String                 @id @default(cuid())
  templateId      String
  title           String
  description     String?                @db.Text
  sortOrder       Int                    @default(0)

  // Timestamps
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  template        QuestionnaireTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions       QuestionnaireQuestion[]

  @@index([templateId])
  @@index([templateId, sortOrder])
}

// Questionnaire Question (FR28)
// Individual questions within a section
model QuestionnaireQuestion {
  id              String                 @id @default(cuid())
  sectionId       String
  questionText    String                 @db.Text
  helpText        String?                @db.Text // Optional guidance for respondents
  questionType    QuestionType
  isRequired      Boolean                @default(false)
  sortOrder       Int                    @default(0)

  // For TEXT type
  isLongText      Boolean                @default(false) // True for textarea, false for input

  // Timestamps
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  section         QuestionnaireSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  choices         QuestionChoice[]       // Options for MULTI_CHOICE type
  responses       QuestionnaireResponse[]

  @@index([sectionId])
  @@index([sectionId, sortOrder])
}

// Question Choice (FR28)
// Options for multi-choice questions
model QuestionChoice {
  id              String                 @id @default(cuid())
  questionId      String
  choiceText      String
  sortOrder       Int                    @default(0)
  isConcerning    Boolean                @default(false) // Flag response for review if selected

  // Timestamps
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  question        QuestionnaireQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([questionId, sortOrder])
}

// Assessment Questionnaire (FR30)
// Instance of a questionnaire template attached to an assessment
model AssessmentQuestionnaire {
  id                String                 @id @default(cuid())
  assessmentId      String
  templateId        String
  status            QuestionnaireStatus    @default(DRAFT)

  // Sending info (FR31)
  recipientEmail    String?                // Email questionnaire was sent to
  sentAt            DateTime?              // When questionnaire was sent
  sentById          String?                // User who sent it

  // Tracking (FR32)
  accessToken       String?                @unique // Secure token for vendor portal access
  tokenExpiresAt    DateTime?              // Token expiration (7 days of inactivity)
  viewedAt          DateTime?              // When vendor first accessed
  startedAt         DateTime?              // When vendor started responding
  completedAt       DateTime?              // When vendor submitted

  // Custom message
  customMessage     String?                @db.Text // Message included in email

  // Scoring summary
  overallScore      Float?                 // Calculated % acceptable after scoring

  // Timestamps
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relations
  assessment        VendorAssessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  template          QuestionnaireTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sentBy            User?                  @relation("QuestionnaireSender", fields: [sentById], references: [id], onDelete: SetNull)

  // Child entities
  responses         QuestionnaireResponse[]
  reminders         QuestionnaireReminder[]

  @@index([assessmentId])
  @@index([templateId])
  @@index([accessToken])
  @@index([status])
}

// Questionnaire Response (FR34, FR39)
// Vendor's response to a question
model QuestionnaireResponse {
  id                  String                  @id @default(cuid())
  questionnaireId     String
  questionId          String

  // Response data (varies by question type)
  textResponse        String?                 @db.Text    // For TEXT and YES_NO
  selectedChoiceId    String?                 // For MULTI_CHOICE
  fileUrl             String?                 // For FILE_UPLOAD - path to uploaded file
  fileName            String?                 // Original filename for FILE_UPLOAD

  // Pre-fill tracking (FR42, FR43)
  isPreFilled         Boolean                 @default(false)
  preFilledFromId     String?                 // ID of response this was pre-filled from
  wasModified         Boolean                 @default(false) // True if vendor modified pre-fill

  // Assessor scoring (FR35)
  score               ResponseScore?
  scoreComment        String?                 @db.Text
  scoredAt            DateTime?
  scoredById          String?

  // Timestamps
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  // Relations
  questionnaire       AssessmentQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  question            QuestionnaireQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scoredBy            User?                   @relation("ResponseScorer", fields: [scoredById], references: [id], onDelete: SetNull)

  // Epic 5: Finding created from this response (FR45, FR50)
  finding             Finding?                @relation("ResponseFinding")

  @@unique([questionnaireId, questionId])
  @@index([questionnaireId])
  @@index([questionId])
}

// Questionnaire Reminder (FR33)
// Tracks automated reminder emails sent
model QuestionnaireReminder {
  id                String                  @id @default(cuid())
  questionnaireId   String
  sentAt            DateTime                @default(now())
  recipientEmail    String
  success           Boolean                 @default(true)
  failureReason     String?

  // Relations
  questionnaire     AssessmentQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([questionnaireId, sentAt])
}

// Questionnaire Settings (FR36)
// Organization-level settings for questionnaire reminders
model QuestionnaireSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique

  // Reminder configuration
  firstReminderDays     Int          @default(7)   // Days after sending to first reminder
  followUpIntervalDays  Int          @default(7)   // Days between subsequent reminders
  maxReminders          Int          @default(3)   // Maximum number of reminders to send

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// BIA Module - Business Impact Assessment
// Epic 9: BIA Configuration Admin
// Epic 10: BIA Core Module
// Epic 11: BIA Impact Assessment
// Epic 12: BIA Dependencies & Integration
// Epic 13: BIA Reporting & Compliance
// ============================================================================

// Business Process Status enum
enum BusinessProcessStatus {
  ACTIVE        // Process is actively operational
  INACTIVE      // Process temporarily inactive
  UNDER_REVIEW  // Process under BIA review
  DELETED       // Soft deleted (preserved for audit)
}

// BIA Assessment Status enum
enum BIAAssessmentStatus {
  NOT_STARTED   // No assessment begun
  DRAFT         // Assessment in progress, not submitted
  COMPLETED     // Assessment submitted and finalized
}

// BIA Configuration (Story 9.1 - FR7, FR8)
// Organization-level BIA methodology configuration
model BIAConfiguration {
  id                    String       @id @default(cuid())
  organizationId        String       @unique

  // Score Scale (FR2)
  scoreScaleMin         Int          @default(1)
  scoreScaleMax         Int          @default(5)

  // Tier Threshold Rules (FR6) - JSON for flexibility
  // Format: [{ "minScore": 4.5, "maxScore": 5.0, "tierId": "tier-id" }, ...]
  tierThresholds        Json         @default("[]")

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Child entities
  impactCategories      BIAImpactCategory[]
  tierDefinitions       BIATierDefinition[]
  timePeriods           BIATimePeriod[]
}

// Impact Category (Story 9.2 - FR1)
// Configurable impact dimensions (Financial, Compliance, Operational, Strategic, etc.)
model BIAImpactCategory {
  id                    String       @id @default(cuid())
  configurationId       String
  name                  String       // e.g., "Financial", "Compliance"
  description           String?      @db.Text
  weight                Float        @default(25)  // Percentage weight (should sum to 100)
  sortOrder             Int          @default(0)
  isActive              Boolean      @default(true)

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  configuration         BIAConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  // Child entities
  tierCriteria          BIATierCriteria[]
  impactScores          BIAImpactScore[]
  timeImpactScores      BIATimeImpactScore[]

  @@unique([configurationId, name])
  @@index([configurationId])
  @@index([configurationId, isActive, sortOrder])
}

// Tier Definition (Story 9.4 - FR3)
// Configurable tier levels (Mission Critical, High, Medium, Low)
model BIATierDefinition {
  id                    String       @id @default(cuid())
  configurationId       String
  name                  String       // e.g., "Mission Critical", "High"
  tierLevel             Int          // 0 = highest priority, 3 = lowest
  rtoText               String       // e.g., "30 minutes", "4 hours"
  rpoText               String       // e.g., "No data loss", "1 hour"
  colorHex              String       @default("#EF4444")  // Display color
  description           String?      @db.Text
  sortOrder             Int          @default(0)
  isActive              Boolean      @default(true)

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  configuration         BIAConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  // Child entities
  tierCriteria          BIATierCriteria[]

  // Business Process relations (named to disambiguate)
  calculatedProcesses   BusinessProcess[]  @relation("CalculatedTierProcesses")
  overrideProcesses     BusinessProcess[]  @relation("OverrideTierProcesses")

  // Epic 14: Asset tier inheritance
  calculatedAssets      Asset[]            @relation("CalculatedTierAssets")

  @@unique([configurationId, name])
  @@unique([configurationId, tierLevel])
  @@index([configurationId])
  @@index([configurationId, isActive, sortOrder])
}

// Tier Criteria (Story 9.5 - FR4)
// Descriptions for each category/tier intersection (16 for 4x4 matrix)
model BIATierCriteria {
  id                    String       @id @default(cuid())
  categoryId            String
  tierId                String
  description           String       @db.Text  // e.g., "$200M+ financial impact"

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  category              BIAImpactCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tier                  BIATierDefinition @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([categoryId, tierId])
  @@index([categoryId])
  @@index([tierId])
}

// Time Period (Story 9.6 - FR5)
// Configurable time periods for time-to-impact matrix
model BIATimePeriod {
  id                    String       @id @default(cuid())
  configurationId       String
  label                 String       // e.g., "30 minutes", "4 hours"
  durationMinutes       Int          // For sorting (e.g., 30, 240, 1440)
  sortOrder             Int          @default(0)
  isActive              Boolean      @default(true)

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  configuration         BIAConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  // Child entities
  timeImpactScores      BIATimeImpactScore[]

  @@unique([configurationId, label])
  @@index([configurationId])
  @@index([configurationId, isActive, sortOrder])
}

// Business Function (Story 10.1 - FR9)
// Parent categories for organizing business processes
model BusinessFunction {
  id                    String       @id @default(cuid())
  identifier            String       // BF-YYYY-NNNN format
  organizationId        String
  name                  String
  description           String?      @db.Text
  isActive              Boolean      @default(true)

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  createdById           String?

  // Relations
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             User?        @relation("BusinessFunctionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Child entities
  businessProcesses     BusinessProcess[]

  @@unique([organizationId, identifier])
  @@unique([organizationId, name])
  @@index([organizationId])
}

// Business Process (Story 10.2 - FR10-FR19, FR52)
// Core BIA entity representing a business process to assess
model BusinessProcess {
  id                    String                @id @default(cuid())
  identifier            String                // BP-YYYY-NNNN format
  organizationId        String
  businessFunctionId    String?               // Optional - process may not be assigned to a function
  name                  String
  description           String?               @db.Text
  status                BusinessProcessStatus @default(ACTIVE)

  // Ownership (FR11, FR12, FR17)
  ownerId               String?               // Process Owner (User)

  // Workaround Documentation (FR18)
  workaroundProcedure   String?               @db.Text

  // Assessment Status
  assessmentStatus      BIAAssessmentStatus   @default(NOT_STARTED)
  lastAssessedAt        DateTime?
  lastAssessedById      String?

  // Tier Assignment (FR23, FR24, FR25)
  calculatedTierId      String?               // Auto-calculated tier
  overrideTierId        String?               // Manual override tier
  overrideJustification String?               @db.Text
  overrideAt            DateTime?
  overrideById          String?

  // Peak Time Criticality (FR39)
  peakTimeDescription   String?               @db.Text  // e.g., "Quarter-end processing"
  peakDays              String?               // JSON array of days ["Monday", "Friday"]
  peakStartTime         String?               // e.g., "09:00"
  peakEndTime           String?               // e.g., "17:00"

  // Resource Dependencies (FR36, FR37, FR38) - JSON for flexibility
  peopleDependencies    Json                  @default("[]")
  facilitiesDependencies Json                 @default("[]")
  transportDependencies Json                  @default("[]")

  // Audit fields
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdById           String?

  // Relations
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessFunction      BusinessFunction?     @relation(fields: [businessFunctionId], references: [id], onDelete: SetNull)
  owner                 User?                 @relation("BusinessProcessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastAssessedBy        User?                 @relation("BusinessProcessAssessor", fields: [lastAssessedById], references: [id], onDelete: SetNull)
  calculatedTier        BIATierDefinition?    @relation("CalculatedTierProcesses", fields: [calculatedTierId], references: [id], onDelete: SetNull)
  overrideTier          BIATierDefinition?    @relation("OverrideTierProcesses", fields: [overrideTierId], references: [id], onDelete: SetNull)
  overrideBy            User?                 @relation("BusinessProcessOverrider", fields: [overrideById], references: [id], onDelete: SetNull)
  createdBy             User?                 @relation("BusinessProcessCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Child entities
  impactScores          BIAImpactScore[]
  timeImpactScores      BIATimeImpactScore[]

  // Dependencies (FR29, FR30)
  upstreamDependencies  BusinessProcessDependency[] @relation("DownstreamProcess")
  downstreamDependencies BusinessProcessDependency[] @relation("UpstreamProcess")

  // Vendor Linkage (FR31, FR32, FR33, FR40)
  vendorLinks           BusinessProcessVendor[]

  // Risk Linkage (FR34, FR35)
  riskLinks             BusinessProcessRisk[]

  // Epic 14: Asset Linkage
  assetLinks            BusinessProcessAsset[]

  // Assessment Requests (FR26, FR41, FR42, FR43, FR44)
  assessmentRequests    BIAAssessmentRequest[]

  @@unique([organizationId, identifier])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, businessFunctionId])
  @@index([organizationId, ownerId])
  @@index([organizationId, calculatedTierId])
  @@index([organizationId, assessmentStatus])
  @@index([ownerId])
}

// Impact Score (Story 11.2 - FR20, FR21)
// Score and description for each impact category
model BIAImpactScore {
  id                    String       @id @default(cuid())
  processId             String
  categoryId            String
  score                 Int          // Score within configured scale (e.g., 1-5)
  description           String?      @db.Text  // Specific impact description

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  process               BusinessProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  category              BIAImpactCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([processId, categoryId])
  @@index([processId])
  @@index([categoryId])
}

// Time-to-Impact Score (Story 11.3 - FR22)
// Score for each category × time period cell in the matrix
model BIATimeImpactScore {
  id                    String       @id @default(cuid())
  processId             String
  categoryId            String
  timePeriodId          String
  score                 Int          // Score within configured scale (e.g., 1-5)

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  process               BusinessProcess   @relation(fields: [processId], references: [id], onDelete: Cascade)
  category              BIAImpactCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  timePeriod            BIATimePeriod     @relation(fields: [timePeriodId], references: [id], onDelete: Cascade)

  @@unique([processId, categoryId, timePeriodId])
  @@index([processId])
  @@index([categoryId])
  @@index([timePeriodId])
}

// Business Process Dependency (Story 12.1, 12.2 - FR29, FR30)
// Self-referential many-to-many for upstream/downstream dependencies
model BusinessProcessDependency {
  id                    String       @id @default(cuid())
  upstreamProcessId     String       // The process being depended on
  downstreamProcessId   String       // The process that depends on upstream
  notes                 String?      @db.Text

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  upstreamProcess       BusinessProcess @relation("UpstreamProcess", fields: [upstreamProcessId], references: [id], onDelete: Cascade)
  downstreamProcess     BusinessProcess @relation("DownstreamProcess", fields: [downstreamProcessId], references: [id], onDelete: Cascade)

  @@unique([upstreamProcessId, downstreamProcessId])
  @@index([upstreamProcessId])
  @@index([downstreamProcessId])
}

// Business Process Vendor Link (Story 12.3 - FR31, FR32, FR33, FR40)
// Junction table linking processes to TPRM vendors
model BusinessProcessVendor {
  id                    String       @id @default(cuid())
  processId             String
  vendorId              String
  notes                 String?      @db.Text
  criticality           String?      // HIGH, MEDIUM, LOW

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  process               BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  vendor                Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([processId, vendorId])
  @@index([processId])
  @@index([vendorId])
}

// Business Process Risk Link (Story 12.4 - FR34, FR35)
// Junction table linking processes to Risk Registry risks
model BusinessProcessRisk {
  id                    String       @id @default(cuid())
  processId             String
  riskId                String
  notes                 String?      @db.Text

  // Timestamps
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  process               BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  risk                  Risk            @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([processId, riskId])
  @@index([processId])
  @@index([riskId])
}

// BIA Assessment Request (Story 11.7 - FR26, FR41, FR42, FR43, FR44)
// Tracks assessment requests sent to Process Owners
enum BIAAssessmentRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model BIAAssessmentRequest {
  id                    String                      @id @default(cuid())
  processId             String
  requestedById         String                      // GRC Analyst who requested
  requestedAt           DateTime                    @default(now())
  dueDate               DateTime?                   // Optional due date
  status                BIAAssessmentRequestStatus  @default(PENDING)
  completedAt           DateTime?
  message               String?                     @db.Text  // Custom message from requester

  // Relations
  process               BusinessProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  requestedBy           User            @relation("AssessmentRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([requestedById])
  @@index([status])
}

// =============================================================================
// Epic 14: Asset Registry & BIA Integration
// =============================================================================

enum AssetType {
  SERVER
  DATABASE
  APPLICATION
  NETWORK
  STORAGE
  ENDPOINT
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
  UNDER_MAINTENANCE
}

// Epic 14: Asset Owner - separate from User for flexible ownership
model AssetOwner {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  department     String?
  title          String?

  // Audit fields
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("AssetOwnerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assets         Asset[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Asset {
  id                String       @id @default(cuid())
  identifier        String       // AST-YYYY-NNNN format
  organizationId    String
  name              String
  type              AssetType
  status            AssetStatus  @default(ACTIVE)
  description       String?      @db.Text

  // Ownership
  ownerId           String?
  businessUnitId    String?

  // Calculated tier (MAX criticality of linked processes)
  calculatedTierId  String?

  // Audit fields
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdById       String?

  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             AssetOwner?  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  businessUnit      BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  calculatedTier    BIATierDefinition? @relation("CalculatedTierAssets", fields: [calculatedTierId], references: [id], onDelete: SetNull)
  createdBy         User?        @relation("AssetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Process links (many-to-many)
  businessProcessLinks BusinessProcessAsset[]

  @@unique([organizationId, identifier])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, calculatedTierId])
  @@index([ownerId])
  @@index([businessUnitId])
}

// Junction table for Asset-BusinessProcess many-to-many relationship
model BusinessProcessAsset {
  id                String   @id @default(cuid())
  businessProcessId String
  assetId           String
  dependencyType    String?  // "PRIMARY", "BACKUP", "SUPPORTING"
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  createdById       String?

  businessProcess   BusinessProcess @relation(fields: [businessProcessId], references: [id], onDelete: Cascade)
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy         User?           @relation("BusinessProcessAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessProcessId, assetId])
  @@index([businessProcessId])
  @@index([assetId])
}
