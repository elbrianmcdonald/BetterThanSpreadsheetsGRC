generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  User                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AuditLog {
  id             String       @id
  organizationId String
  userId         String?      // Nullable for SYSTEM actions (AC8)
  action         AuditAction
  entityType     String
  entityId       String
  changes        Json?
  timestamp      DateTime     @default(now())
  ipAddress      String?
  userAgent      String?
  // Story 4.12: Actor snapshots for audit compliance (AC7)
  actorName      String?      // Snapshot of actor's name at time of action
  actorRole      String?      // Snapshot of actor's role at time of action
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, timestamp])
  @@index([organizationId, userId])
  @@index([timestamp])
  // Story 4.12: Index for audit trail queries by entity
  @@index([entityId, timestamp])
}

model Control {
  id              String       @id
  organizationId  String
  frameworkId     String
  controlId       String
  title           String
  description     String
  guidance        String?
  parentControlId String?
  baselines       String?      // Comma-separated baseline tags: "LOW,MODERATE,HIGH" or "PRIVACY"
  isActive        Boolean      @default(true)
  // Story 12.4: Track if control was imported from OSCAL (locked from editing)
  isOscalImported Boolean      @default(false)
  isCustom        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  Framework       Framework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  Organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Control         Control?     @relation("ControlToControl", fields: [parentControlId], references: [id])
  other_Control   Control[]    @relation("ControlToControl")
  // Story 12.1: Control linkage relations
  RiskLinks       RiskControlLink[]
  FindingLinks    FindingControlLink[]
  // Organizational Controls mapped to this framework control
  OrganizationalControls OrganizationalControl[] @relation("OrgControlToFrameworkControl")
  // Standards module: Standard controls mapped to this framework control
  StandardControlMappings StandardControlMapping[]
  // Compliance Assessment Module: Individual control scores
  ControlAssessmentScores ControlAssessmentScore[]
  // Base Framework Mapping: Controls mapped FROM this control (as source)
  SourceMappings          FrameworkControlMapping[] @relation("SourceControlMappings")
  // Base Framework Mapping: Controls mapped TO this control (as base target)
  TargetMappings          FrameworkControlMapping[] @relation("TargetControlMappings")
  // Control Domain tagging
  ControlDomains          ControlDomainControl[]

  @@unique([frameworkId, controlId])
  @@index([frameworkId])
  @@index([frameworkId, isActive])
  @@index([organizationId, frameworkId])
  @@index([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, isCustom])
  @@index([parentControlId])
}

model ControlDomain {
  id                    String                  @id
  code                  String                  @unique
  name                  String
  description           String
  sortOrder             Int
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  ControlDomainMapping  ControlDomainMapping[]
  EvidenceControlDomain EvidenceControlDomain[]
  // Control tagging relations
  Controls              ControlDomainControl[]
  StandardControls      ControlDomainStandardControl[]
  MaturityDomains       ControlDomainMaturityDomain[]

  @@index([isActive, sortOrder])
  @@index([sortOrder])
}

model ControlDomainMapping {
  id              String        @id
  controlDomainId String
  frameworkCode   String
  controlId       String
  confidence      Int           @default(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  ControlDomain   ControlDomain @relation(fields: [controlDomainId], references: [id], onDelete: Cascade)

  @@unique([controlDomainId, frameworkCode, controlId])
  @@index([controlDomainId, frameworkCode])
  @@index([controlDomainId])
  @@index([frameworkCode, controlId])
}

model Evidence {
  id                    String                  @id
  organizationId        String
  title                 String
  originalFileName      String
  description           String?
  filePath              String
  fileSize              Int
  fileType              String
  uploadedBy            String
  currentVersion        Int                     @default(1)
  isActive              Boolean                 @default(true)
  deletedAt             DateTime?
  // BU-Scoped Compliance: Evidence belongs to specific business unit
  businessUnitId        String?                 // Nullable for migration, will be required
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  Organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User                  User                    @relation(fields: [uploadedBy], references: [id])
  BusinessUnit          BusinessUnit?           @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  EvidenceControlDomain EvidenceControlDomain[]
  EvidenceVersion       EvidenceVersion[]
  RiskEvidence          RiskEvidence[]
  // Story 3.12: Evidence requests fulfilled by this evidence
  EvidenceRequest       EvidenceRequest[]
  // Story 14.6: Finding evidence attachments
  FindingEvidence       FindingEvidence[]

  // Story 3.1: Strategy module - Objectives linked to this evidence
  linkedObjectives      Objective[]       @relation("ObjectiveLinkedEvidence")

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, uploadedBy])
  @@index([organizationId, deletedAt])
  @@index([uploadedBy])
  @@index([organizationId, businessUnitId])
}

model EvidenceVersion {
  id            String    @id @default(cuid())
  evidenceId    String
  versionNumber Int
  filename      String
  fileSize      Int
  storagePath   String
  changeReason  String
  uploadedById  String
  uploadedAt    DateTime
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  Evidence      Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  User          User      @relation(fields: [uploadedById], references: [id])

  @@unique([evidenceId, versionNumber])
  @@index([evidenceId, versionNumber])
  @@index([evidenceId])
}

model EvidenceControlDomain {
  id              String        @id
  evidenceId      String
  controlDomainId String
  createdAt       DateTime      @default(now())
  ControlDomain   ControlDomain @relation(fields: [controlDomainId], references: [id], onDelete: Cascade)
  Evidence        Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, controlDomainId])
  @@index([controlDomainId])
  @@index([evidenceId])
}

// Control Domain to Framework Control tagging
model ControlDomainControl {
  id              String        @id @default(cuid())
  controlDomainId String
  controlId       String
  createdAt       DateTime      @default(now())

  ControlDomain   ControlDomain @relation(fields: [controlDomainId], references: [id], onDelete: Cascade)
  Control         Control       @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([controlDomainId, controlId])
  @@index([controlDomainId])
  @@index([controlId])
}

// Control Domain to Standard Control tagging
model ControlDomainStandardControl {
  id                String          @id @default(cuid())
  controlDomainId   String
  standardControlId String
  createdAt         DateTime        @default(now())

  ControlDomain     ControlDomain   @relation(fields: [controlDomainId], references: [id], onDelete: Cascade)
  StandardControl   StandardControl @relation(fields: [standardControlId], references: [id], onDelete: Cascade)

  @@unique([controlDomainId, standardControlId])
  @@index([controlDomainId])
  @@index([standardControlId])
}

// Control Domain to Maturity Domain tagging
model ControlDomainMaturityDomain {
  id               String         @id @default(cuid())
  controlDomainId  String
  maturityDomainId String
  createdAt        DateTime       @default(now())

  ControlDomain    ControlDomain  @relation(fields: [controlDomainId], references: [id], onDelete: Cascade)
  MaturityDomain   MaturityDomain @relation(fields: [maturityDomainId], references: [id], onDelete: Cascade)

  @@unique([controlDomainId, maturityDomainId])
  @@index([controlDomainId])
  @@index([maturityDomainId])
}

model Framework {
  id                                 String       @id
  organizationId                     String
  code                               String
  name                               String
  version                            String
  description                        String?
  publicationDate                    DateTime?
  sourceUrl                          String?
  oscalCatalog                       Json?
  isActive                           Boolean      @default(false)
  activatedAt                        DateTime?
  activatedBy                        String?
  targetCompletionDate               DateTime?
  deactivatedAt                      DateTime?
  deactivatedBy                      String?
  createdAt                          DateTime     @default(now())
  updatedAt                          DateTime
  Control                            Control[]
  User_Framework_activatedByToUser   User?        @relation("Framework_activatedByToUser", fields: [activatedBy], references: [id])
  User_Framework_deactivatedByToUser User?        @relation("Framework_deactivatedByToUser", fields: [deactivatedBy], references: [id])
  Organization                       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Story 5.1: Framework coverage caching and history
  FrameworkCoverage                  FrameworkCoverage[]
  CoverageHistory                    CoverageHistory[]
  // BU-Scoped Compliance: Business unit assignments for this framework
  businessUnitAssignments            BusinessUnitFramework[]
  // Compliance Assessment Module
  ComplianceAssessment               ComplianceAssessment[]
  // Base-centric Control Mapping: Organizations using this framework as base
  OrganizationsAsBase                Organization[] @relation("BaseFramework")

  @@unique([organizationId, code, version])
  @@index([code])
  @@index([isActive])
  @@index([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, isActive])
}

model LoginAttempt {
  id        String   @id
  email     String
  ipAddress String?
  success   Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([email, timestamp])
  @@index([ipAddress, timestamp])
}

model Organization {
  id              String            @id
  name            String
  slug            String            @unique
  settings        Json?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  AuditLog        AuditLog[]
  Control         Control[]
  Evidence        Evidence[]
  Framework       Framework[]
  Risk            Risk[]
  User            User[]
  // Story 3.12: Evidence Request workflow
  EvidenceRequest EvidenceRequest[]
  // Story 4.2: Risk Templates for organization
  RiskTemplate    RiskTemplate[]
  // Story 4.5: Remediation options for organization
  RemediationOption RemediationOption[]
  // Story 4.10: Risk status history for organization
  RiskStatusHistory RiskStatusHistory[]
  // Story 4.11: Risk comments for organization (AC5)
  RiskComment       RiskComment[]
  // Story 4.15: Email queue for organization
  EmailQueue        EmailQueue[]
  // Story 5.1: Framework coverage caching and history
  FrameworkCoverage FrameworkCoverage[]
  CoverageHistory   CoverageHistory[]
  // Story 7.0.1: Business Units for organizational structure (AC15)
  BusinessUnit      BusinessUnit[]
  // Story 7.1: Findings for organization (AC19)
  Finding           Finding[]
  // Story 7.5: RiskAssessment relations
  RiskAssessment    RiskAssessment[]
  RiskScenario      RiskScenario[]
  // Story 7.8.1: Assessment Types for organization (AC5)
  AssessmentType    AssessmentType[]
  // Assessment Tasks for proactive risk discovery
  AssessmentTask    AssessmentTask[]
  // Story 7.8.2: Risk Matrix Templates for organization
  RiskMatrixTemplate RiskMatrixTemplate[]
  // Story 7.10: Risk Register Entries for organization (AC15)
  RiskRegisterEntry  RiskRegisterEntry[]
  // Story 14.5: Finding comments for organization
  FindingComment     FindingComment[]
  // Story 14.6: Finding evidence for organization
  FindingEvidence    FindingEvidence[]
  // Story 15.8: Risk treatments for organization
  RiskTreatment      RiskTreatment[]
  // Person: Stakeholders for accountability tracking
  Person             Person[]
  // BU-Scoped Compliance: Framework-BU assignments for organization
  BusinessUnitFramework BusinessUnitFramework[]
  // Organizational Controls: User-defined controls
  OrganizationalControl     OrganizationalControl[]
  RiskOrganizationalControl RiskOrganizationalControl[]
  // Story 1.1: Security Strategy Module - Strategies for organization
  Strategy                  Strategy[]
  // Standards Module: Standards and exceptions for organization
  Standard                  Standard[]
  ControlException          ControlException[]
  // Maturity Assessment Module: Custom frameworks and assessments
  MaturityFramework         MaturityFramework[]
  MaturityAssessment        MaturityAssessment[]
  MaturityQuestion          MaturityQuestion[]    @relation("MaturityQuestionOrg")
  // Compliance Assessment Module
  ComplianceAssessment      ComplianceAssessment[]
  // Risk Assessment Project Module: Container-based risk discovery workflow
  RiskAssessmentProject     RiskAssessmentProject[]
  // Base Framework Mapping: Framework-to-framework control mappings
  FrameworkControlMapping   FrameworkControlMapping[]

  // Base-centric Control Mapping: Organization's base for control mappings
  baseType                  BaseType?   // FRAMEWORK or STANDARD
  baseFrameworkId           String?     // FK when baseType = FRAMEWORK
  baseStandardId            String?     // FK when baseType = STANDARD

  // Relations for base selection
  BaseFramework             Framework?  @relation("BaseFramework", fields: [baseFrameworkId], references: [id], onDelete: SetNull)
  BaseStandard              Standard?   @relation("BaseStandard", fields: [baseStandardId], references: [id], onDelete: SetNull)

  // Epic 1: TPRM Vendor Registry
  Vendor                    Vendor[]
  // Epic 3: Vendor Assessment Workflow
  VendorAssessment          VendorAssessment[]
  // Epic 4: Questionnaire System
  QuestionnaireTemplate     QuestionnaireTemplate[]
  QuestionnaireSettings     QuestionnaireSettings?

  // BIA Module: Business Impact Assessment
  BIAConfiguration          BIAConfiguration?
  BusinessFunction          BusinessFunction[]
  BusinessProcess           BusinessProcess[]

  // Epic 14: Asset Registry
  Asset                     Asset[]
  AssetOwner                AssetOwner[]

  @@index([active])
  @@index([slug])
}

// ============================================================================
// Story 1.1: Security Strategy Module - Strategy & Goal Models
// Enables organizations to define overarching security strategies with
// hierarchical goals for tracking strategic initiatives
// ============================================================================

// Strategy Model - Top-level container for security strategic plans
// Supports multiple strategies per organization (e.g., annual roadmap, compliance strategy)
model Strategy {
  id              String         @id @default(cuid())
  organizationId  String
  title           String
  description     String?        @db.Text
  fiscalYearStart Int            // Start year of strategy period (e.g., 2025)
  fiscalYearEnd   Int            // End year of strategy period (e.g., 2026)
  status          StrategyStatus @default(DRAFT)

  // Ownership
  ownerId         String?        // Executive sponsor/owner of the strategy
  createdById     String?        // User who created the strategy

  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?          @relation("StrategyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("StrategyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  goals           Goal[]         // Child goals within this strategy

  // Story 4.1: History tracking
  history         StrategyHistory[]

  // Indexes for common queries
  @@index([organizationId])
  @@index([organizationId, status])
}

// Goal Model - Strategic goals within a strategy
// Each goal contains objectives (added in Story 2.1)
model Goal {
  id          String    @id @default(cuid())
  strategyId  String
  title       String
  description String?   @db.Text
  sortOrder   Int       @default(0)  // Display order within strategy
  targetDate  DateTime? // Target completion date for the goal

  // Ownership
  ownerId     String?   // Goal owner responsible for achievement
  createdById String?   // User who created the goal

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  strategy    Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  owner       User?     @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("GoalCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Story 2.1: Objectives within this goal
  objectives  Objective[]

  // Story 2.4: Comments on this goal
  comments    Comment[]

  // Story 4.1: History tracking
  history     GoalHistory[]

  // Indexes for common queries
  @@index([strategyId])
  @@index([strategyId, sortOrder])
}

// Story 2.1: Objective Model - Measurable objectives within a goal
// Each objective has a KPI type that determines how progress is calculated
model Objective {
  id           String          @id @default(cuid())
  goalId       String
  title        String
  description  String?         @db.Text
  status       ObjectiveStatus @default(NOT_STARTED)
  sortOrder    Int             @default(0)  // Display order within goal
  dueDate      DateTime?       // Target completion date

  // KPI fields for progress tracking
  kpiType      KpiType         @default(MANUAL_PERCENTAGE)
  targetValue  Float?          // Target value for the KPI (e.g., 100 for percentage)
  currentValue Float?          @default(0)  // Current progress value

  // Ownership
  createdById  String?         // User who created the objective

  // Timestamps
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relations
  goal         Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("ObjectiveCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Many-to-many: Users assigned to this objective
  assignees    ObjectiveAssignee[]

  // Story 2.4: Comments on this objective
  comments     Comment[]

  // Story 3.1: Entity Linking - Many-to-many relations to operational GRC data
  linkedRisks    Risk[]                 @relation("ObjectiveLinkedRisks")
  linkedControls OrganizationalControl[] @relation("ObjectiveLinkedControls")
  linkedEvidence Evidence[]             @relation("ObjectiveLinkedEvidence")

  // Story 4.1: History tracking
  history        ObjectiveHistory[]

  // Indexes for common queries
  @@index([goalId])
  @@index([goalId, sortOrder])
  @@index([status])
  @@index([dueDate])
}

// Story 2.1: Join table for Objective-User many-to-many (assignees)
model ObjectiveAssignee {
  id          String    @id @default(cuid())
  objectiveId String
  userId      String
  assignedAt  DateTime  @default(now())

  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  user        User      @relation("ObjectiveAssignees", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, userId])
  @@index([objectiveId])
  @@index([userId])
}

// Story 2.4: Comment Model - Comments on Goals and Objectives
// AC1: Polymorphic relation - Comment can belong to either Goal or Objective
model Comment {
  id          String    @id @default(cuid())
  content     String    @db.Text  // AC2: Comment content
  authorId    String               // AC2: User who wrote the comment

  // Polymorphic relations - only one should be set
  goalId      String?              // FK to Goal (if commenting on a goal)
  objectiveId String?              // FK to Objective (if commenting on an objective)

  // Timestamps
  createdAt   DateTime  @default(now())  // AC2: Creation timestamp
  updatedAt   DateTime  @updatedAt

  // Relations
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  // Indexes for efficient queries
  @@index([goalId])
  @@index([objectiveId])
  @@index([authorId])
  @@index([createdAt])
}

// ============================================================================
// Story 4.1: History Tracking Models for Strategy Module
// Immutable audit trail for all changes to Strategy, Goal, and Objective entities
// ============================================================================

// Story 4.1 AC1: Strategy History - Tracks all changes to Strategy entities
// Story 6.3: History records are preserved when Strategy is deleted (onDelete: SetNull)
model StrategyHistory {
  id            String     @id @default(cuid())
  strategyId    String?                       // FK to Strategy being tracked (nullable to preserve history after delete)
  changeType    ChangeType                    // CREATE, UPDATE, or DELETE
  changedFields Json                          // JSON object with old/new values for changed fields
  changedById   String                        // User who made the change
  changedAt     DateTime   @default(now())    // When the change occurred

  // Relations - SetNull preserves history records when Strategy is deleted
  strategy      Strategy?  @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  changedBy     User       @relation("StrategyHistoryChanger", fields: [changedById], references: [id])

  // AC5: Indexes for efficient querying
  @@index([strategyId, changedAt])
  @@index([changedById])
}

// Story 4.1 AC2: Goal History - Tracks all changes to Goal entities
// Story 6.3: History records are preserved when Goal is deleted (onDelete: SetNull)
model GoalHistory {
  id            String     @id @default(cuid())
  goalId        String?                       // FK to Goal being tracked (nullable to preserve history after delete)
  changeType    ChangeType                    // CREATE, UPDATE, or DELETE
  changedFields Json                          // JSON object with old/new values for changed fields
  changedById   String                        // User who made the change
  changedAt     DateTime   @default(now())    // When the change occurred

  // Relations - SetNull preserves history records when Goal is deleted
  goal          Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  changedBy     User       @relation("GoalHistoryChanger", fields: [changedById], references: [id])

  // AC5: Indexes for efficient querying
  @@index([goalId, changedAt])
  @@index([changedById])
}

// Story 4.1 AC3: Objective History - Tracks all changes to Objective entities
// Story 6.3: History records are preserved when Objective is deleted (onDelete: SetNull)
model ObjectiveHistory {
  id            String     @id @default(cuid())
  objectiveId   String?                       // FK to Objective being tracked (nullable to preserve history after delete)
  changeType    ChangeType                    // CREATE, UPDATE, or DELETE
  changedFields Json                          // JSON object with old/new values for changed fields
  changedById   String                        // User who made the change
  changedAt     DateTime   @default(now())    // When the change occurred

  // Relations - SetNull preserves history records when Objective is deleted
  objective     Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  changedBy     User       @relation("ObjectiveHistoryChanger", fields: [changedById], references: [id])

  // AC5: Indexes for efficient querying
  @@index([objectiveId, changedAt])
  @@index([changedById])
}

// Story 7.8.1: Assessment Type Schema (AC1-AC5)
// Categorizes risk assessments (IT Risk, Vendor Risk, Compliance Risk, etc.)
model AssessmentType {
  id              String   @id @default(cuid())
  organizationId  String
  name            String                 // AC2: Name required
  description     String?  @db.Text      // AC2: Optional description
  isActive        Boolean  @default(true) // AC2: Soft delete flag
  isDefault       Boolean  @default(false) // Story 7.8.4 AC4: Cannot delete default type
  createdAt       DateTime @default(now()) // AC2: Timestamp
  updatedAt       DateTime @updatedAt      // AC2: Timestamp

  // AC5: Relation to Organization
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Relation to RiskAssessments using this type
  riskAssessments RiskAssessment[]
  // Relation to AssessmentTasks using this type
  assessmentTasks AssessmentTask[]

  @@unique([organizationId, name])  // AC3: Unique name per organization
  @@index([organizationId, isActive]) // AC4: Index for active type queries
}

// Assessment Task Model
// Proactive risk assessment tasks that managers assign to analysts
// Unlike RiskAssessment (which requires a Finding), these are created independently
// to enable scheduled/ad-hoc risk discovery assessments
model AssessmentTask {
  id              String               @id @default(cuid())
  organizationId  String

  // Task identification
  identifier      String               // TASK-YYYY-NNNN format
  title           String               // e.g., "Q1 2026 IT Infrastructure Risk Assessment"
  description     String?              @db.Text

  // Scope definition - what area to assess
  scope           String               @db.Text  // Description of assessment scope
  businessUnitId  String?              // Optional: specific BU to assess
  assessmentTypeId String?             // Optional: type of assessment (IT Risk, Vendor Risk, etc.)

  // Assignment
  assignedToId    String?              // Analyst assigned to perform the assessment
  assignedById    String               // Manager who created/assigned the task
  assignedAt      DateTime?            // When the task was assigned
  selfAssignedAt  DateTime?            // When analyst self-assigned (null if admin-assigned)

  // Unified assessment type (for cross-module assignments)
  unifiedType     UnifiedAssessmentType @default(RISK_DISCOVERY)
  entityId        String?              // Linked entity ID (Risk, Finding, Vendor, etc.)
  entityType      String?              // Entity type string for routing ("Risk", "Finding", etc.)

  // Lifecycle
  status          AssessmentTaskStatus @default(PENDING)
  priority        String               @default("MEDIUM") // HIGH, MEDIUM, LOW
  dueDate         DateTime?            // When the assessment should be completed
  startedAt       DateTime?            // When analyst started working
  completedAt     DateTime?            // When assessment was completed

  // Results summary (filled on completion)
  risksIdentified Int                  @default(0) // Count of risks discovered
  summary         String?              @db.Text    // Completion summary/notes

  // Audit trail
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo      User?                @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy      User                 @relation("TaskAssigner", fields: [assignedById], references: [id])
  businessUnit    BusinessUnit?        @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  assessmentType  AssessmentType?      @relation(fields: [assessmentTypeId], references: [id], onDelete: SetNull)

  // Risks discovered during this assessment task
  discoveredRisks Risk[]               @relation("TaskDiscoveredRisks")

  @@unique([organizationId, identifier])
  @@index([organizationId, status])
  @@index([organizationId, assignedToId])
  @@index([organizationId, dueDate])
  @@index([organizationId, unifiedType])
  @@index([organizationId, entityType, entityId])
}

// Story 7.8.2: Risk Matrix Template Schema (AC1-AC7)
// Container for risk matrix versions, defines structure and output scale
model RiskMatrixTemplate {
  id               String    @id @default(cuid())
  organizationId   String
  name             String                          // AC2: Name required
  description      String?   @db.Text              // AC2: Optional description
  dimensionCount   Int       @default(2)           // AC3: 2 = L×I, 3 = L×I×E
  gridSize         Int       @default(5)           // Story 11.1: 3x3, 4x4, or 5x5 matrix grid
  outputScaleMax   Decimal   @db.Decimal(10, 4)    // AC4: Max score value
  currentVersionId String?   @unique               // AC5: Nullable until first publish
  isActive         Boolean   @default(true)        // Soft delete flag
  isDefault        Boolean   @default(false)       // Story 7.8.4: Cannot delete default template
  createdAt        DateTime  @default(now())       // AC2: Timestamp
  updatedAt        DateTime  @updatedAt            // AC2: Timestamp

  // AC5: Relation to Organization
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Story 7.8.3: Version relations
  versions         RiskMatrixVersion[] @relation("TemplateVersions")
  currentVersion   RiskMatrixVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@unique([organizationId, name])  // AC6: Unique name per organization
  @@index([organizationId, isActive]) // AC7: Index for active template queries
}

// Story 7.8.3: RiskMatrixVersion Schema & Lifecycle (AC1-AC8)
// Stores versioned configurations of risk matrix scales and thresholds
model RiskMatrixVersion {
  id              String    @id @default(cuid())   // AC2: Unique identifier
  templateId      String                           // AC2: Parent template reference
  versionNumber   Int                              // AC5: Auto-incremented per template
  scales          Json                             // AC2,AC3: MatrixScales JSON structure
  thresholds      Json                             // AC2,AC4: Threshold[] JSON structure
  isActive        Boolean   @default(false)        // AC19: Drafts start inactive
  publishedAt     DateTime?                        // AC21: Set on publish
  publishedBy     String?                          // AC21: User who published
  createdAt       DateTime  @default(now())        // AC2: Timestamp

  // AC8: Relations
  template        RiskMatrixTemplate  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  templateCurrent RiskMatrixTemplate? @relation("CurrentVersion")
  publisher       User?               @relation("MatrixVersionPublisher", fields: [publishedBy], references: [id])
  assessmentProjects RiskAssessmentProject[] @relation("ProjectMatrixVersion")

  @@unique([templateId, versionNumber])  // AC6: Unique version per template
  @@index([templateId, isActive])        // AC7: Index for active version queries
}

// Story 7.0.1: Business Unit Schema with Hierarchy (AC1-AC10)
// Supports hierarchical organizational structure for assignment and reporting
model BusinessUnit {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  code            String?  // Short code like "FIN", "ENG-PLAT" (AC2)
  parentId        String?  // Self-referencing for hierarchy (AC3)
  isActive        Boolean  @default(true)   // Soft delete (AC9)
  sortOrder       Int      @default(0)      // Display ordering within parent (AC10)

  createdAt       DateTime @default(now())  // AC8
  updatedAt       DateTime @updatedAt       // AC8

  // Self-referencing hierarchy (AC4: BUHierarchy relation)
  parent          BusinessUnit?  @relation("BUHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        BusinessUnit[] @relation("BUHierarchy")

  // Organization relation (AC5)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Story 7.0.2: Users in this BU (AC3)
  users           User[]

  // Story 7.0.6: Findings affecting this BU (AC5)
  affectedFindings Finding[] @relation("FindingAffectedBUs")

  // Story 15.2: Risks associated with this BU
  risks           Risk[]

  // BU-Scoped Compliance: Evidence in this BU
  evidence        Evidence[]

  // BU-Scoped Compliance: Frameworks assigned to this BU
  frameworkAssignments BusinessUnitFramework[]

  // BU-Scoped Compliance: Coverage records for this BU
  frameworkCoverage    FrameworkCoverage[]
  coverageHistory      CoverageHistory[]

  // Story 16.1: Risk assessments for this BU
  riskAssessments      RiskAssessment[] @relation("AssessmentBusinessUnit")
  // Assessment tasks scoped to this BU
  assessmentTasks      AssessmentTask[]

  // Compliance assessments for this BU
  complianceAssessments ComplianceAssessment[]

  // Person: People in this BU for accountability tracking
  people          Person[]

  // Risk treatments scoped to this BU
  riskTreatments  RiskTreatment[] @relation("TreatmentBusinessUnit")

  // Epic 1: TPRM Vendor Registry - Vendors in this BU
  vendors         Vendor[]

  // Epic 14: Asset Registry - Assets in this BU
  assets          Asset[]

  @@unique([organizationId, name])          // AC6: Unique name per org
  @@index([organizationId, parentId])       // AC7: Index for hierarchy queries
  @@index([organizationId, isActive])       // Index for active BU queries
}

// Person: Accountability tracking for risk ownership and treatment assignments
// Distinct from User (system accounts) - represents stakeholders who may or may not have system access
model Person {
  id              String   @id @default(cuid())
  organizationId  String
  name            String                      // Full name
  email           String?                     // Contact email (optional)
  jobTitle        String?                     // Role/title for context
  businessUnitId  String?                     // Primary business unit
  isActive        Boolean  @default(true)     // Soft delete

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  // Accountability relationships
  treatmentAssignments  RiskTreatment[] @relation("TreatmentAssignee")
  riskAssessmentOwner   RiskAssessment[] @relation("AssessmentRiskOwner")
  projectRiskOwner      RiskAssessmentProject[] @relation("ProjectRiskOwner")

  // Ownership relationships (IT Owner / Business Owner)
  vendorsAsITOwner           Vendor[]          @relation("VendorITOwner")
  vendorsAsBusinessOwner     Vendor[]          @relation("VendorBusinessOwner")
  risksAsITOwner             Risk[]            @relation("RiskITOwner")
  risksAsBusinessOwner       Risk[]            @relation("RiskBusinessOwner")
  assessmentsAsBusinessOwner RiskAssessment[]  @relation("AssessmentBusinessOwner")

  @@unique([organizationId, email])         // Unique email per org (when email provided)
  @@index([organizationId, isActive])
  @@index([organizationId, businessUnitId])
  @@index([organizationId, name])
}

// BU-Scoped Compliance: Junction table for Framework-BusinessUnit assignments
// Enables explicit assignment of which frameworks apply to which business units
model BusinessUnitFramework {
  id              String       @id @default(cuid())
  businessUnitId  String
  frameworkId     String
  organizationId  String
  assignedAt      DateTime     @default(now())
  assignedById    String?

  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  framework       Framework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy      User?        @relation("FrameworkAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([businessUnitId, frameworkId])
  @@index([organizationId, frameworkId])
  @@index([organizationId, businessUnitId])
}

model PasswordResetToken {
  id        String   @id
  userId    String
  token     String   @unique
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([expires])
  @@index([token])
  @@index([userId])
}

model Risk {
  id              String            @id @default(cuid())
  identifier      String?           // RISK-2026-0001 format (optional for backfill)
  organizationId  String
  title           String
  description     String            @db.Text
  affectedSystems String?           @db.Text
  severity        Severity
  status          RiskStatus        @default(OPEN)
  createdById     String?
  // Story 4.2: Optional template reference for tracking template usage
  templateId      String?

  // Story 4.3: Finding context fields (AC18-AC22)
  findingSource    RiskFindingSource? // AC18: How the risk was discovered
  cveId            String?            // AC19: CVE/Reference ID for vulnerability tracking
  discoveryDate    DateTime?          // AC20: When the risk was discovered (defaults to createdAt if not specified)
  technicalDetails String?            @db.Text // AC21: Collapsible technical details section with markdown

  // Story 4.6: Risk ownership assignment (AC1-AC6)
  itOwnerId       String?            // AC1: IT Stakeholder for technical remediation
  businessOwnerId String?            // AC1: Business Stakeholder for business decisions
  assignedAt      DateTime?          // AC5: When ownership was assigned
  assignedById    String?            // AC5: Who assigned the ownership (GRC Analyst)

  // Story 4.7: Impact calculation fields (AC7, AC8, AC13)
  assetCriticality        AssetCriticality @default(MEDIUM) // AC8: Asset criticality for impact calculation
  nextAuditDate           DateTime?        // AC13: Next audit date for proximity calculation
  impactScore             Int              @default(0)      // AC7: Calculated impact score (0-100)
  impactScoreCalculatedAt DateTime?        // When impact was last calculated

  // Story 4.8: Business Impact Statement Generation (AC6)
  businessImpactStatement        String?   @db.Text  // AC6: Auto-generated business impact statement
  impactStatementManuallyEdited  Boolean   @default(false) // AC33-36: Flag for manual edits
  impactStatementGeneratedAt     DateTime? // When statement was last generated

  // Story 4.10: Remediation verification fields (AC36-AC40)
  remediationVerifiedById           String?
  remediationVerificationComments   String?   @db.Text  // AC40: Verification comments

  // ============================================================================
  // Story 15.5: MITRE ATT&CK Threat Modeling Integration
  // ============================================================================
  initialAccessVectorId String?  // Single technique for initial access vector

  // ============================================================================
  // Story 15.6-15.7: Inherent and Residual Severity Scoring
  // ============================================================================
  // Inherent scoring (before controls)
  inherentLikelihood    Decimal?  @db.Decimal(10, 4)
  inherentImpact        Decimal?  @db.Decimal(10, 4)
  inherentExposure      Decimal?  @db.Decimal(10, 4)  // For 3D matrices
  inherentScore         Decimal?  @db.Decimal(10, 4)
  inherentScoreLabel    String?   // e.g., "Critical", "High", "Medium", "Low"

  // Residual scoring (after controls)
  residualLikelihood    Decimal?  @db.Decimal(10, 4)
  residualImpact        Decimal?  @db.Decimal(10, 4)
  residualExposure      Decimal?  @db.Decimal(10, 4)  // For 3D matrices
  residualScore         Decimal?  @db.Decimal(10, 4)
  residualScoreLabel    String?

  // Matrix version used for scoring (locked at first save)
  matrixVersionId       String?

  // Controls documentation
  mitigatingControlsInPlace    String?  @db.Text  // Current mitigating controls
  preventativeControlsInPlace  String?  @db.Text  // Current preventative controls
  mitigatingControlsNeeded     String?  @db.Text  // Needed mitigating controls
  preventativeControlsNeeded   String?  @db.Text  // Needed preventative controls

  // ============================================================================
  // Risk Assessment Assignment & Approval Workflow
  // Enables GRC managers to assign risk assessments to users with approval workflow
  // ============================================================================
  assessorId              String?   // User assigned to perform the assessment
  assessmentCreatedAt     DateTime? // When the assessment was assigned
  assessmentCreatedById   String?   // Manager who created/assigned the assessment
  assessmentDueDate       DateTime? // SLA deadline for completing assessment
  assessmentSubmittedAt   DateTime? // When assessor submitted for review
  assessmentReviewerId    String?   // Manager who reviewed the assessment
  assessmentReviewedAt    DateTime? // When review was completed (approved/rejected)
  assessmentReviewNotes   String?   @db.Text  // Notes from reviewer (esp. for rejection)
  assessmentRevisionCount Int       @default(0) // Number of revision cycles

  // ============================================================================
  // Story 15.10: Spawned from Finding Tracking
  // ============================================================================
  spawnedFromFindingId  String?  // Link to original finding if risk was spawned
  spawnReason           RiskSpawnReason?  // Why the risk was spawned

  // ============================================================================
  // Story 15.2: Business Unit Association
  // ============================================================================
  businessUnitId        String?  // Business unit this risk belongs to

  // ============================================================================
  // Story 16.10: Risk Assessment Association
  // ============================================================================
  assessmentId          String?  // RiskAssessment this risk belongs to (for child risks)

  // ============================================================================
  // Assessment Task Association - Proactive Risk Discovery
  // ============================================================================
  assessmentTaskId      String?  // AssessmentTask this risk was discovered during

  // ============================================================================
  // Risk Assessment Project Feature - Container-based risk discovery
  // ============================================================================
  discoveryProjectId    String?                // RiskAssessmentProject this risk was discovered in
  discoveryStatus       RiskDiscoveryStatus?   // PENDING until assessment approved, then PUBLISHED

  // ============================================================================
  // Epic 5: Vendor Risk Integration (FR48-FR49)
  // Links risks to vendors and vendor assessments
  // ============================================================================
  vendorId              String?  // Vendor this risk is associated with
  vendorAssessmentId    String?  // VendorAssessment where risk was identified

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relationships (AC13, AC14)
  Organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  CreatedBy    User?           @relation("RiskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Story 4.2: Risk created from template (AC: Task 5.3)
  Template     RiskTemplate?   @relation("RiskFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  RiskEvidence RiskEvidence[]
  // Story 4.5: Remediation options for this risk (AC4)
  RemediationOptions RemediationOption[]
  // Story 4.6: Risk ownership relationships (AC1)
  ITOwner      Person?         @relation("RiskITOwner", fields: [itOwnerId], references: [id], onDelete: SetNull)
  BusinessOwner Person?        @relation("RiskBusinessOwner", fields: [businessOwnerId], references: [id], onDelete: SetNull)
  AssignedBy   User?           @relation("RiskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  // Risk Assessment Assignment Workflow relationships
  Assessor               User?  @relation("RiskAssessor", fields: [assessorId], references: [id], onDelete: SetNull)
  AssessmentCreatedBy    User?  @relation("RiskAssessmentCreatedBy", fields: [assessmentCreatedById], references: [id], onDelete: SetNull)
  AssessmentReviewer     User?  @relation("RiskAssessmentReviewer", fields: [assessmentReviewerId], references: [id], onDelete: SetNull)
  // Story 4.10: Status history and verification (AC31-AC40)
  StatusHistory              RiskStatusHistory[]
  RemediationVerifiedBy      User?    @relation("RiskRemediationVerifier", fields: [remediationVerifiedById], references: [id], onDelete: SetNull)
  // Story 4.11: Risk comments for collaboration (AC5)
  Comments                   RiskComment[]
  // Story 12.1: Control linkage (AC1-AC8)
  ControlLinks               RiskControlLink[]
  // Organizational Controls: User-defined controls linked to this risk
  OrganizationalControls     RiskOrganizationalControl[]

  // Story 15.5: MITRE ATT&CK relationships
  InitialAccessVector  MitreTechnique?    @relation("RiskInitialAccess", fields: [initialAccessVectorId], references: [id], onDelete: SetNull)
  ThreatSteps          RiskThreatStep[]   // Attack chain techniques
  ThreatObjectives     RiskThreatObjective[]  // Objective techniques

  // Story 15.10: Spawned from finding relationship
  SpawnedFromFinding   Finding?           @relation("RiskSpawnedFromFinding", fields: [spawnedFromFindingId], references: [id], onDelete: SetNull)

  // Story 15.2: Business unit relationship
  BusinessUnit         BusinessUnit?      @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  // Story 16.10: Assessment relationship (child risks)
  Assessment           RiskAssessment?    @relation("AssessmentChildRisks", fields: [assessmentId], references: [id], onDelete: SetNull)

  // Assessment Task relationship (proactive discovery)
  AssessmentTask       AssessmentTask?    @relation("TaskDiscoveredRisks", fields: [assessmentTaskId], references: [id], onDelete: SetNull)

  // Risk Assessment Project relationship (container-based discovery)
  DiscoveryProject     RiskAssessmentProject? @relation("ProjectDiscoveredRisks", fields: [discoveryProjectId], references: [id], onDelete: SetNull)

  // Story 15.8: Treatment records
  Treatments           RiskTreatment[]

  // Story 3.1: Strategy module - Objectives linked to this risk
  linkedObjectives     Objective[]        @relation("ObjectiveLinkedRisks")

  // Epic 5: Vendor risk integration relations
  Vendor               Vendor?            @relation("VendorRisks", fields: [vendorId], references: [id], onDelete: SetNull)
  VendorAssessment     VendorAssessment?  @relation("VendorAssessmentRisks", fields: [vendorAssessmentId], references: [id], onDelete: SetNull)

  // BIA Module: Business Processes linked to this risk (FR35)
  businessProcessLinks BusinessProcessRisk[]

  @@index([organizationId])
  @@index([organizationId, severity])
  @@index([organizationId, status])
  @@index([severity])
  @@index([status])
  // Story 4.6: Indexes for assignment queries (Task 1.4)
  @@index([itOwnerId])
  @@index([businessOwnerId])
  @@index([assignedById])
  // Story 4.7: Indexes for impact score sorting (Task 1.4)
  @@index([impactScore])
  @@index([organizationId, impactScore])
  // Story 15: New indexes
  @@index([initialAccessVectorId])
  @@index([spawnedFromFindingId])
  @@index([businessUnitId])
  @@index([assessmentTaskId])
  @@index([inherentScore])
  @@index([residualScore])
  @@index([assessmentId])  // Story 16.10: Child risks query
  // Risk Assessment Assignment Workflow indexes
  @@index([assessorId])  // Assessor's assignment queries
  @@index([organizationId, assessorId, status])  // My assignments query
  @@index([organizationId, status, assessmentSubmittedAt])  // Review queue query
  // Risk Assessment Project indexes (container-based discovery)
  @@index([discoveryProjectId])  // Query risks within a project
  @@index([discoveryStatus])  // Filter by discovery status
  @@index([organizationId, discoveryStatus])  // Risk register filtered view
  // Epic 5: Vendor risk integration indexes
  @@index([vendorId])
  @@index([vendorAssessmentId])
  @@index([organizationId, vendorId])
  // Risk identifier
  @@unique([organizationId, identifier])
}

model RiskEvidence {
  id         String               @id @default(cuid())
  riskId     String
  evidenceId String
  linkType   RiskEvidenceLinkType
  linkedById String
  linkedAt   DateTime             @default(now())
  Risk       Risk                 @relation(fields: [riskId], references: [id], onDelete: Cascade)
  Evidence   Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  LinkedBy   User                 @relation(fields: [linkedById], references: [id])

  @@unique([riskId, evidenceId])
  @@index([riskId])
  @@index([evidenceId])
}

// Story 4.10: Risk Status History model (AC31-AC34)
// Immutable record of all status transitions for audit trail
model RiskStatusHistory {
  id             String       @id @default(cuid())
  riskId         String
  oldStatus      RiskStatus
  newStatus      RiskStatus
  reason         String?      @db.Text  // Required for reopening closed risks
  changedById    String
  organizationId String

  changedAt      DateTime     @default(now())

  // Relationships
  Risk           Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)
  ChangedBy      User         @relation("RiskStatusChanger", fields: [changedById], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([riskId, changedAt])
  @@index([organizationId])
}

// Story 4.11: Risk Comment model (AC1-AC6)
// Enables collaboration on risks through comments with typed categories
// Supports markdown formatting, soft delete, and audit trail
model RiskComment {
  id              String       @id @default(cuid())
  riskId          String
  comment         String       @db.Text  // AC3: Up to 5,000 characters with markdown
  commentType     CommentType  @default(GENERAL) // AC2: Comment type enum
  authorId        String?      // AC6: Null if author deleted (preserve comment history)
  organizationId  String
  deletedAt       DateTime?    // AC20: Soft delete for "deleted" placeholder

  createdAt       DateTime     @default(now()) // AC4: Created timestamp
  updatedAt       DateTime     @updatedAt      // AC4: Updated timestamp

  // AC5: Relationships - belongs to Risk, User (author), Organization
  Risk            Risk         @relation(fields: [riskId], references: [id], onDelete: Cascade)
  Author          User?        @relation("RiskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  Organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // AC1: Indexes for efficient querying
  @@index([riskId, createdAt])    // Comments sorted by time for a risk
  @@index([organizationId])       // Multi-tenant query optimization
}

// Story 4.5: Remediation Option model (AC1-AC7)
// Stores multiple remediation options per risk with cost estimates, timelines, and effort levels
// Enables Business Stakeholders to evaluate different remediation approaches
model RemediationOption {
  id               String              @id @default(cuid())
  riskId           String
  title            String              @db.VarChar(200)
  description      String              @db.Text
  approach         String              @db.Text
  costEstimate     Decimal             @db.Decimal(12, 2) // Up to $9,999,999,999.99
  timelineEstimate String              @db.VarChar(100)   // Flexible text: "2-3 weeks", "1 month"
  effortLevel      EffortLevel
  priority         RemediationPriority
  selectedStatus   SelectionStatus?    // null = not yet reviewed (AC7)
  selectedAt       DateTime?
  selectedById     String?
  createdById      String              // AC5
  organizationId   String              // AC5
  createdAt        DateTime            @default(now()) // AC6
  updatedAt        DateTime            @updatedAt      // AC6

  // Relationships
  Risk         Risk          @relation(fields: [riskId], references: [id], onDelete: Cascade)
  CreatedBy    User          @relation("RemediationOptionCreator", fields: [createdById], references: [id])
  SelectedBy   User?         @relation("RemediationOptionApprover", fields: [selectedById], references: [id])
  Organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([riskId])                     // AC4: Multiple options per risk
  @@index([organizationId, riskId])     // Multi-tenant query optimization
  @@index([organizationId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                                      String            @id
  name                                    String?
  email                                   String?           @unique
  emailVerified                           DateTime?
  image                                   String?
  hashedPassword                          String?
  role                                    UserRole          @default(AUDITOR)
  organizationId                          String
  // Story 7.0.2: Business Unit assignment (AC1-AC4)
  businessUnitId                          String?           // Optional - user not yet assigned to BU
  // Story 3.7: Assigned framework codes for auditor role access control (AC19-AC21)
  assignedFrameworks                      String[]          @default([])
  createdAt                               DateTime          @default(now())
  updatedAt                               DateTime
  Account                                 Account[]
  AuditLog                                AuditLog[]
  Evidence                                Evidence[]
  EvidenceVersion                         EvidenceVersion[]
  Framework_Framework_activatedByToUser   Framework[]       @relation("Framework_activatedByToUser")
  Framework_Framework_deactivatedByToUser Framework[]       @relation("Framework_deactivatedByToUser")
  RiskEvidence                            RiskEvidence[]
  Session                                 Session[]
  Organization                            Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Story 7.0.2: Business Unit relationship (AC2)
  businessUnit                            BusinessUnit?     @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  // Story 3.12: Evidence Request relationships
  EvidenceRequestsReceived                EvidenceRequest[] @relation("EvidenceRequestRecipient")
  EvidenceRequestsSent                    EvidenceRequest[] @relation("EvidenceRequestRequester")
  // Story 4.1: Risks created by this user
  RisksCreated                            Risk[]            @relation("RiskCreator")
  // Story 4.5: Remediation options created/approved by this user
  RemediationOptionsCreated               RemediationOption[] @relation("RemediationOptionCreator")
  RemediationOptionsApproved              RemediationOption[] @relation("RemediationOptionApprover")
  // Story 4.6: Risk assignment tracking
  RisksAssignedByMe                       Risk[]            @relation("RiskAssignedBy")
  // Risk Assessment Assignment Workflow relationships
  RisksAssessedByMe                       Risk[]            @relation("RiskAssessor")
  RiskAssessmentsCreatedByMe              Risk[]            @relation("RiskAssessmentCreatedBy")
  RiskAssessmentsReviewedByMe             Risk[]            @relation("RiskAssessmentReviewer")
  // Story 4.10: Status history and verification relationships
  RiskStatusChanges                       RiskStatusHistory[] @relation("RiskStatusChanger")
  RisksVerified                           Risk[]            @relation("RiskRemediationVerifier")
  // Story 4.11: Risk comments authored by this user (AC5)
  RiskComments                            RiskComment[]     @relation("RiskCommentAuthor")
  // Story 7.1: Finding relationships (AC16-AC18)
  FindingsCreated                         Finding[]         @relation("FindingCreator")
  FindingsTriaged                         Finding[]         @relation("FindingTriager")
  FindingsAccepted                        Finding[]         @relation("FindingAccepter")
  // Story 7.0.8: Findings assigned to this user (AC3)
  FindingsAssigned                        Finding[]         @relation("FindingAssignee")
  // Story 7.5: RiskAssessment relationships (AC30-AC32)
  AssessmentsCreated                      RiskAssessment[]  @relation("AssessmentCreator")
  AssessmentsOwned                        RiskAssessment[]  @relation("AssessmentOwner")
  AssessmentsApproved                     RiskAssessment[]  @relation("AssessmentApprover")
  AssessmentsPerformed                    RiskAssessment[]  @relation("AssessmentPerformer")
  // Assessment Task relations - proactive risk assessments
  AssessmentTasksAssigned                 AssessmentTask[]  @relation("TaskAssignee")
  AssessmentTasksCreated                  AssessmentTask[]  @relation("TaskAssigner")
  // Story 7.8.3: Matrix version publishing (AC8)
  MatrixVersionsPublished                 RiskMatrixVersion[] @relation("MatrixVersionPublisher")
  // Story 7.10: Risk Register Entry relationships (AC13-AC14)
  RiskRegisterEntriesOwned                RiskRegisterEntry[] @relation("RiskRegisterOwner")
  RiskRegisterEntriesClosed               RiskRegisterEntry[] @relation("RiskRegisterCloser")
  // Story 16.6: Risk Register Status changes
  RiskRegisterStatusChanges               RiskRegisterStatusHistory[] @relation("RiskRegisterStatusChanger")
  // Story 12.1: Control linkage creator relationships
  RiskControlLinksCreated                 RiskControlLink[]   @relation("RiskControlLinkCreator")
  FindingControlLinksCreated              FindingControlLink[] @relation("FindingControlLinkCreator")
  // Story 14.5: Finding comments authored by this user
  FindingComments                         FindingComment[]    @relation("FindingCommentUser")
  // Story 14.6: Finding evidence attached by this user
  FindingEvidenceAttached                 FindingEvidence[]   @relation("FindingEvidenceAttacher")

  // Story 15.8: Risk treatment decisions made/completed by this user
  TreatmentsDecided                       RiskTreatment[]     @relation("TreatmentDecider")
  TreatmentsCompleted                     RiskTreatment[]     @relation("TreatmentCompleter")
  // BU-Scoped Compliance: Framework-BU assignments made by this user
  FrameworkAssignments                    BusinessUnitFramework[] @relation("FrameworkAssigner")
  // Organizational Controls: Controls created by this user
  OrganizationalControlsCreated           OrganizationalControl[] @relation("OrgControlCreator")
  RiskOrganizationalControlsCreated       RiskOrganizationalControl[] @relation("RiskOrgControlCreator")
  // Story 1.1: Security Strategy Module - User relations for Strategy & Goal ownership
