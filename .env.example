# =============================================================================
# BetterThanSpreadsheetsGRC Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.
# Required values are marked with [REQUIRED].

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=        # [REQUIRED] Set a strong password
POSTGRES_DB=betterthanspreadsheetsGRC

# --- Authentication ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=              # [REQUIRED] Session encryption secret
NEXTAUTH_URL=http://localhost  # Full public URL (e.g., https://grc.example.com)

# --- Cron Jobs ---
# [REQUIRED in production] Authenticates scheduled jobs that hit /api/cron/*.
# Without this, those endpoints would be callable anonymously and could be
# abused to trigger reminder emails or flip SLA-breach flags.
#
# Generate (Linux/macOS): openssl rand -hex 32
# Generate (PowerShell):  -join ((1..64) | %{ '{0:x}' -f (Get-Random -Max 16) })
# Or run: ./scripts/setup-env.sh (Linux/macOS) or .\scripts\setup-env.ps1 (Windows)
#
# Point your scheduler (Vercel Cron, GitHub Actions, k8s CronJob, host cron) to:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://<your-host>/api/cron/finding-sla-breach
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://<your-host>/api/cron/treatment-sla-breach
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://<your-host>/api/cron/evidence-request-reminders
CRON_SECRET=

# --- Networking ---
# Default mode (no Caddy): app accessible on this port
APP_PORT=80

# Production mode (--profile production): Caddy handles HTTPS
# Set your domain and clear APP_PORT when using Caddy:
# DOMAIN=grc.example.com
# APP_PORT=
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Optional: Email ---
# EMAIL_PROVIDER: sendgrid | ses | console (default: console)
#
# SECURITY NOTE: with EMAIL_PROVIDER=console there is no out-of-band channel,
# so password-reset links are shown on-screen to whoever requests them. That
# keeps "forgot password" self-service without email, but it means anyone who
# can name a registered email can obtain a working reset link — only use
# console mode on trusted/internal deployments. Set sendgrid or ses below to
# email the link instead (the on-screen link is then automatically disabled).
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=BetterThanSpreadsheetsGRC

# SendGrid (required if EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=

# AWS SES (required if EMAIL_PROVIDER=ses)
# AWS_SES_REGION=
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=

# --- Optional: ClamAV Malware Scanning ---
# Enable with: docker compose --profile clamav up -d
# ENABLE_CLAMAV=true
# CLAMAV_HOST=clamav

# --- Optional: Background Workers ---
# WORKER_ENABLED=true
# WORKER_INTERVAL=30000

# --- Optional: First-run database seeding ---
# Set to true on first startup to seed frameworks and demo data
# SEED_ON_STARTUP=false
# Or seed manually: docker exec betterthanspreadsheetsGRC-app tsx prisma/seed.ts
