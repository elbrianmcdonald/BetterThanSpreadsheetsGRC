# BetterThanSpreadsheetsGRC Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Database
# PostgreSQL connection string for local development
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use "betterthanspreadsheetsGRC" for consistency with Docker setup
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betterthanspreadsheetsGRC"

# Docker PostgreSQL Configuration (for docker-compose.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="betterthanspreadsheetsGRC"

# Authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Azure AD / Entra ID (Optional - for Azure AD authentication)
# Obtain from Azure Portal -> App Registrations
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Discord Provider (Optional - for development/testing)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Email Service (Optional - for notifications)
# SendGrid or AWS SES configuration
EMAIL_SERVER_HOST="smtp.sendgrid.net"
EMAIL_SERVER_PORT="587"
EMAIL_FROM="noreply@betterthanspreadsheetsgrc.com"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# File Storage
FILE_STORAGE_PATH="./uploads"

# Malware Scanning (ClamAV)
# For Docker: clamav service hostname
CLAMAV_HOST="clamav"
# Path to clamscan binary in Docker container
CLAMSCAN_PATH="/usr/bin/clamdscan"
